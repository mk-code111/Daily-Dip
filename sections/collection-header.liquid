<header 
  id="collection-header-{{ section.id }}"
  class="collection-header">
  {% for block in section.blocks %}
    {% if block.type == 'mobile' %}
      {% liquid 
        assign text_animation = ''
        unless block.settings.text_animation == blank
          assign text_animation = block.settings.text_animation | prepend: 'animate__animated '
        endunless
      %}
      <div 
        class="
          collection-header-mobile image-overlay d-desktop-none
          {{ block.settings.bg_color }} 
          {{ block.settings.text_color }}
          {{ block.settings.border_top_width | prepend: 'border-top-' }}
          {{ block.settings.border_bottom_width | prepend: 'border-bottom-' }}
          {{ block.settings.border_color }} 
          {{ block.settings.pt | prepend: 'pt-' }} 
          {{ block.settings.pb | prepend: 'pb-' }}
        "
        style="
          --bs-bg-opacity: {{ block.settings.bg_opacity | append: '%' }};
          --bs-border-opacity: {{ block.settings.border_opacity | append: '%' }};
          background-image: linear-gradient({{ block.settings.bg_gradient_direction | append: 'deg' }}, rgba(var(--text-color-rgb), {{ block.settings.bg_gradient_opacity | append: '%'}}), rgba(var(--text-color-rgb), 0));
        "
        data-has-collection-img="{% if block.settings.img_show and collection.image != nil %}true{% else %}false{% endif %}"
        {{ block.shopify_attributes }}>
        {% if block.settings.img_show and collection.image != nil %}
          <div 
            class="img-wrapper"
            style="
              --overlay-color-rgb: {{ block.settings.img_overlay_color | prepend: 'var(--' | append: ')' }};
              --overlay-opacity: {{ block.settings.img_overlay_opacity | append: '%' }};
              --overlay-blur: {{ block.settings.img_overlay_blur | append: 'px' }}
            ">
            <img
              src="{{ collection.image | image_url: width: 800 }}"
              class="img-fluid"
              alt="{{ collection.image.alt }}"
              width="800"
              height="{{ 800 | divided_by: collection.image.aspect_ratio | round }}"
              loading="eager">
            </div>
        {% endif %}
        <div class="container {{ block.settings.text_align }}">
          {% if block.settings.breadcrumb %}
            <div class="breadcrumb-wrapper mb-4 {{ text_animation }}">
              {% render 'breadcrumb' %}
            </div>
          {% endif %}
          <h2 class="title {{ block.settings.title_font_size }} {{ text_animation }}">
            <span>{{ collection.title }}</span>
          </h2>
          {% if block.settings.description_show and collection.description != blank %}
            <div class="description rte mt-3 mb-0 {{ block.settings.description_font_size }} {{ text_animation }}">
              {{ collection.description }}
            </div>
          {% endif %}
        </div>
      </div>
    {% else %}
      {% liquid 
        assign text_animation = ''
        unless block.settings.text_animation == blank
          assign text_animation = block.settings.text_animation | prepend: 'animate__animated '
        endunless
      %}
      <div 
        class="
          collection-header-desktop d-none d-desktop-block
          {{ block.settings.bg_color }} 
          {{ block.settings.text_color }}
          {{ block.settings.border_top_width | prepend: 'border-top-' }}
          {{ block.settings.border_bottom_width | prepend: 'border-bottom-' }}
          {{ block.settings.border_color }} 
        "
        style="
          --bs-bg-opacity: {{ block.settings.bg_opacity | append: '%' }};
          --bs-border-opacity: {{ block.settings.border_opacity | append: '%' }};
          background-image: linear-gradient({{ block.settings.bg_gradient_direction | append: 'deg' }}, rgba(var(--text-color-rgb), {{ block.settings.bg_gradient_opacity | append: '%'}}), rgba(var(--text-color-rgb), 0));
        "
        data-has-collection-img="{% if block.settings.img_show and collection.image != nil %}true{% else %}false{% endif %}"
        {{ block.shopify_attributes }}>
        {% if block.settings.img_show and collection.image != nil %}
          <div 
            class="img-wrapper {% if block.settings.img_align == '' %}img-wrapper-left{% else %}img-wrapper-right{% endif %}"
            style=" 
              --overlay-color-rgb: {{ block.settings.img_overlay_color | prepend: 'var(--' | append: ')' }};
              --overlay-opacity: {{ block.settings.img_overlay_opacity | append: '%' }};
              --overlay-blur: {{ block.settings.img_overlay_blur | append: 'px' }}
            ">
            <img
              src="{{ collection.image | image_url: width: 1200 }}"
              class="img-fluid {% unless block.settings.text_animation == blank %}animate__animated animate__fadeIn{% endunless %}"
              alt="{{ collection.image.alt }}"
              width="1200"
              height="{{ 1200 | divided_by: collection.image.aspect_ratio | round }}"
              loading="eager">
            </div>
        {% endif %}
        {% if block.settings.breadcrumb %}
          <div class="breadcrumb-wrapper animate__animated animate__fadeIn">
            {% render 'breadcrumb' %}
          </div>
        {% endif %}
        <div class="container">
          <div class="row align-items-center {{ block.settings.img_align }}">
            {% if block.settings.img_show and collection.image != nil %}
              <div class="col-9">
              </div>
            {% endif %}
            <div 
              class="
                {% if block.settings.img_show and collection.image != nil %}col-9{% else %}col-18{% endif %}
                {{ block.settings.text_align }}
                {{ block.settings.pt | prepend: 'pt-' }} 
                {{ block.settings.pb | prepend: 'pb-' }}
              ">
              <h2 class="title {{ block.settings.title_font_size }} {{ text_animation }}">
                <span>{{ collection.title }}</span>
              </h2>
              {% if block.settings.description_show and collection.description != blank %}
                <div class="description rte mt-3 mb-0 {{ block.settings.description_font_size }} {{ text_animation }}">
                  {{ collection.description }}
                </div>
              {% endif %}
            </div>
          </div>
        </div>
      </div>
    {% endif %}
  {% endfor %}

</header>

