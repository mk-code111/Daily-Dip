<section
  id="countdown-{{ section.id }}" 
  class="
    countdown viewport-detect
    {{ section.settings.bg_outter_color }} 
    {{ section.settings.text_color }}
    {{ section.settings.pt | prepend: 'pt-' }} 
    {{ section.settings.pb | prepend: 'pb-' }}
  "
  style="
    --bs-bg-opacity: {{ section.settings.bg_outter_opacity | append: '%' }};
    background-image: linear-gradient({{ section.settings.bg_outter_gradient_direction | append: 'deg' }}, rgba(var({{ section.settings.bg_outter_gradient_color }}), {{ section.settings.bg_outter_gradient_opacity | append: '%'}}), rgba(var(--text-color-rgb), 0));
  ">
  <div 
    class="container" 
    style="max-width: {{ section.settings.container_max_width }}px">
    <div 
      class="
        countdown-inner
        {{ section.settings.bg_color }}
        {{ section.settings.border_width | prepend: 'border-' }}
        {{ section.settings.border_color }} 
      "
      style="
        --bs-bg-opacity: {{ section.settings.bg_opacity | append: '%' }};
        --bs-border-opacity: {{ section.settings.border_opacity | append: '%' }};
      ">
      {% for block in section.blocks %}
        {% if block.type == 'countdown' %}
          <animated-countdown
            class="animated-countdown"
            style="--animation-name: {{ block.settings.animation }}"
            data-time="{{ block.settings.time }}"
            data-has-animation="{% if block.settings.animation != blank %}true{% else %}false{% endif %}"
            role="timer"
            {{ block.shopify_attributes }}>
            <span style="animation-delay: 100ms;">
              <span 
                class="
                  {{ block.settings.bg_color }} 
                  {{ section.settings.bg_gradient }}
                  {{ block.settings.text_color }}
                  {{ block.settings.border_width | prepend: 'border-' }}
                  {{ block.settings.border_color }}
                "
                style="
                  --bs-bg-opacity: {{ block.settings.bg_opacity | append: '%' }};
                  --bs-border-opacity: {{ block.settings.border_opacity | append: '%' }};
                "
                data-days>
              </span>
            </span>
            <span style="animation-delay: 200ms;">
              <span 
                class="
                  {{ block.settings.bg_color }} 
                  {{ section.settings.bg_gradient }}
                  {{ block.settings.text_color }}
                  {{ block.settings.border_width | prepend: 'border-' }}
                  {{ block.settings.border_color }}
                "
                style="
                  --bs-bg-opacity: {{ block.settings.bg_opacity | append: '%' }};
                  --bs-border-opacity: {{ block.settings.border_opacity | append: '%' }};
                "
                data-hours>
              </span>
            </span>
            <span style="animation-delay: 300ms;">
              <span
                class="
                  {{ block.settings.bg_color }} 
                  {{ section.settings.bg_gradient }}
                  {{ block.settings.text_color }}
                  {{ block.settings.border_width | prepend: 'border-' }}
                  {{ block.settings.border_color }}
                "
                style="
                  --bs-bg-opacity: {{ block.settings.bg_opacity | append: '%' }};
                  --bs-border-opacity: {{ block.settings.border_opacity | append: '%' }};
                "
                data-min>
              </span>
            </span>
            <span style="animation-delay: 400ms;">
              <span 
                class="
                  {{ block.settings.bg_color }} 
                  {{ section.settings.bg_gradient }}
                  {{ block.settings.text_color }}
                  {{ block.settings.border_width | prepend: 'border-' }}
                  {{ block.settings.border_color }}
                "
                style="
                  --bs-bg-opacity: {{ block.settings.bg_opacity | append: '%' }};
                  --bs-border-opacity: {{ block.settings.border_opacity | append: '%' }};
                "
                data-sec>
              </span>
            </span>
          </animated-countdown>
        {% else %}
          <div 
            class="
              pt-12 pt-tablet-14 pb-10
              px-6 px-desktop-10
              {{ block.settings.text_align_mobile }} 
              {{ block.settings.text_align_desktop }}
            "
            {{ block.shopify_attributes }}>
            {% unless block.settings.subtitle == blank %}
              <div class="subtitle mb-0 {{ block.settings.subtitle_font_size }}">
                {{ block.settings.subtitle }}
              </div>
            {% endunless %}
            {% unless block.settings.title == blank %}
              <h2 class="title {{ block.settings.title_font_size }}">
                {{ block.settings.title }}
              </h2>
            {% endunless %}
            {% unless block.settings.description == blank %}
              <div class="description rte {{ block.settings.description_font_size }}">
                {{ block.settings.description }}
              </div>
            {% endunless %}
            {% unless block.settings.btn_primary_text == blank %}
              <div class="d-inline-flex m-n2">
                {% unless block.settings.btn_primary_text == blank %}
                  <a 
                    class="btn m-2 {{ block.settings.btn_primary_color }}" 
                    href="{{ block.settings.btn_primary_url }}">
                    {{ block.settings.btn_primary_text }}
                  </a>
                {% endunless %}
                {% unless block.settings.btn_secondary_text == blank %}
                  <a 
                    class="btn m-2 {{ block.settings.btn_secondary_color }}" 
                    href="{{ block.settings.btn_secondary_url }}">
                    {{ block.settings.btn_secondary_text }}
                  </a>
                {% endunless %}
              </div>
            {% endunless %}
          </div>
        {% endif %}
    {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Countdown",
  "settings": [
    {
      "type": "header",
      "content": "Styling - outter"
    },
    {
      "type": "select",
      "id": "bg_outter_color",
      "label": "Background color",
      "default": "bg-primary",
      "options": [
        { "value": "bg-primary", "label": "Primary" },
        { "value": "bg-secondary", "label": "Secondary" },
        { "value": "bg-body", "label": "Body" },
        { "value": "bg-white", "label": "White" }
      ]
    },
    {
      "type": "range",
      "id": "bg_outter_opacity",
      "label": "Background opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 5,
      "unit": "%"
    },
    {
      "type": "select",
      "id": "bg_outter_gradient_color",
      "label": "Gradient color",
      "default": "--bs-body-color-rgb",
      "options": [
        { "value": "--bs-primary-rgb", "label": "Primary" },
        { "value": "--bs-secondary-rgb", "label": "Secondary" },
        { "value": "--bs-body-color-rgb", "label": "Body" },
        { "value": "--bs-white-rgb", "label": "White" }
      ]
    },
    {
      "type": "range",
      "id": "bg_outter_gradient_opacity",
      "label": "Background gradient opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 0,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "bg_outter_gradient_direction",
      "label": "Background gradient direction",
      "min": 0,
      "max": 360,
      "step": 15,
      "default": 180,
      "unit": "deg"
    },
    {
      "type": "header",
      "content": "Styling - inner"
    },
    {
      "type": "select",
      "id": "bg_color",
      "label": "Background color",
      "default": "bg-body",
      "options": [
        { "value": "bg-primary", "label": "Primary" },
        { "value": "bg-secondary", "label": "Secondary" },
        { "value": "bg-body", "label": "Body" },
        { "value": "bg-white", "label": "White" }
      ]
    },
    {
      "type": "range",
      "id": "bg_opacity",
      "label": "Background opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 100,
      "unit": "%"
    },
    {
      "type": "select",
      "id": "text_color",
      "label": "Text color",
      "default": "text-body",
      "options": [
        { "value": "text-primary", "label": "Primary" },
        { "value": "text-secondary", "label": "Secondary" },
        { "value": "text-body", "label": "Body" },
        { "value": "text-white", "label": "White" }
      ]
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "default": 0,
      "min": 0,
      "max": 16,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "border_color",
      "label": "Border color",
      "default": "border-body",
      "options": [
        { "value": "border-primary", "label": "Primary" },
        { "value": "border-secondary", "label": "Secondary" },
        { "value": "border-body", "label": "Body" },
        { "value": "border-white", "label": "White" }
      ]
    },
    {
      "type": "range",
      "id": "border_opacity",
      "label": "Border opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 100,
      "unit": "%"
    },
    {
      "type": "text",
      "id": "container_max_width",
      "label": "Container max-width (px)",
      "info": "Leave empty to use the global container width"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Padding top",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 10
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Padding bottom",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 10
    }
  ],
  "blocks": [
    {
      "type": "countdown",
      "name": "Countdown",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "time",
          "label": "Time",
          "info": "Based on the unix time in seconds. [Learn more](https://www.epochconverter.com/)."
        },
        {
          "type": "header",
          "content": "Styling"
        },
        {
          "type": "select",
          "id": "bg_color",
          "label": "Background color",
          "default": "bg-body",
          "options": [
            { "value": "bg-primary", "label": "Primary" },
            { "value": "bg-secondary", "label": "Secondary" },
            { "value": "bg-body", "label": "Body" },
            { "value": "bg-white", "label": "White" }
          ]
        },
        {
          "type": "range",
          "id": "bg_opacity",
          "label": "Background opacity",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 100,
          "unit": "%"
        },
        {
          "type": "select",
          "id": "bg_gradient",
          "label": "Background gradient",
          "options": [
            { "value": "bg-gradient", "label": "Yes" },
            { "value": "", "label": "No" }
          ],
          "default": ""
        },
        {
          "type": "select",
          "id": "text_color",
          "label": "Text color",
          "default": "text-body",
          "options": [
            { "value": "text-primary", "label": "Primary" },
            { "value": "text-secondary", "label": "Secondary" },
            { "value": "text-body", "label": "Body" },
            { "value": "text-white", "label": "White" }
          ]
        },
        {
          "type": "range",
          "id": "border_width",
          "label": "Border width",
          "default": 2,
          "min": 0,
          "max": 16,
          "step": 1,
          "unit": "px"
        },
        {
          "type": "select",
          "id": "border_color",
          "label": "Border color",
          "default": "border-primary",
          "options": [
            { "value": "border-primary", "label": "Primary" },
            { "value": "border-secondary", "label": "Secondary" },
            { "value": "border-body", "label": "Body" },
            { "value": "border-white", "label": "White" }
          ]
        },
        {
          "type": "range",
          "id": "border_opacity",
          "label": "Border opacity",
          "min": 0,
          "max": 100,
          "step": 5,
          "default": 100,
          "unit": "%"
        },
        {
          "type": "select",
          "id": "animation",
          "label": "Animation on scroll",
          "info": "NOTE: You must click the \"Save\" button to preview changes",
          "default": "fadeInRight",
          "options": [
            { "value": "", "label": "None" },
            { "value": "fadeIn", "label": "FadeIn" },
            { "value": "fadeInUp", "label": "FadeInUp" },
            { "value": "fadeInDown", "label": "FadeInDown" },
            { "value": "fadeInLeft", "label": "FadeInLeft" },
            { "value": "fadeInRight", "label": "FadeInRight" },
            { "value": "zoomIn", "label": "ZoomIn" }
          ]
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "text_align_mobile",
          "label": "Text align - mobile",
          "default": "text-center",
          "options": [
            { "value": "text-start", "label": "Left" },
            { "value": "text-center", "label": "Center" },
            { "value": "text-end", "label": "Right" }
          ]
        },
        {
          "type": "select",
          "id": "text_align_desktop",
          "label": "Text align - desktop",
          "default": "text-desktop-start",
          "options": [
            { "value": "text-desktop-start", "label": "Left" },
            { "value": "text-desktop-center", "label": "Center" },
            { "value": "text-desktop-end", "label": "Right" }
          ]
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Optional Subtitle",
          "info": "Leave empty to disable"
        },
        {
          "type": "select",
          "id": "subtitle_font_size",
          "label": "Subtitle font-size",
          "default": "fs-md",
          "options": [
            { "value": "fs-xs", "label": "xs" },
            { "value": "fs-sm", "label": "sm" },
            { "value": "fs-md", "label": "md" },
            { "value": "fs-lg", "label": "lg" },
            { "value": "fs-xl", "label": "xl" }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Media with text"
        },
        {
          "type": "select",
          "id": "title_font_size",
          "label": "Title font-size",
          "default": "h2",
          "options": [
            { "value": "h1", "label": "H1" },
            { "value": "h2", "label": "H2" },
            { "value": "h3", "label": "H3" },
            { "value": "h4", "label": "H4" },
            { "value": "h5", "label": "H5" },
            { "value": "h6", "label": "H6" }
          ]
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description (optional)",
          "default": "<p>Either show an image, video (MP4) or an external video (YouTube). If no text block is shown, the media will take full section's space.</p>"
        },
        {
          "type": "select",
          "id": "description_font_size",
          "label": "Description font-size",
          "default": "fs-md",
          "options": [
            { "value": "fs-xs", "label": "xs" },
            { "value": "fs-sm", "label": "sm" },
            { "value": "fs-md", "label": "md" },
            { "value": "fs-lg", "label": "lg" },
            { "value": "fs-xl", "label": "xl" }
          ]
        },
        {
          "type": "header",
          "content": "Primary button"
        },
        {
          "type": "text",
          "id": "btn_primary_text",
          "label": "Button text",
          "default": "Primary button",
          "info": "Leave empty to disable"
        },
        {
          "type": "url",
          "id": "btn_primary_url",
          "label": "Button URL"
        },
        {
          "type": "select",
          "id": "btn_primary_color",
          "label": "Button color",
          "default": "btn-primary",
          "options": [
            { "group": "Solid", "value": "btn-primary", "label": "Primary" },
            { "group": "Solid", "value": "btn-secondary", "label": "Secondary" },
            { "group": "Solid", "value": "btn-white", "label": "White" },
            { "group": "Light", "value": "btn-light-primary", "label": "Primary" },
            { "group": "Light", "value": "btn-light-secondary", "label": "Secondary" },
            { "group": "Light", "value": "btn-light-white", "label": "White" },
            { "group": "Outline", "value": "btn-outline-primary", "label": "Primary" },
            { "group": "Outline", "value": "btn-outline-secondary", "label": "Secondary" },
            { "group": "Outline", "value": "btn-outline-white", "label": "White" }
          ]
        },
        {
          "type": "header",
          "content": "Secondary button"
        },
        {
          "type": "text",
          "id": "btn_secondary_text",
          "label": "Button text",
          "default": "Secondary button",
          "info": "Leave empty to disable"
        },
        {
          "type": "url",
          "id": "btn_secondary_url",
          "label": "Button URL"
        },
        {
          "type": "select",
          "id": "btn_secondary_color",
          "label": "Button color",
          "default": "btn-secondary",
          "options": [
            { "group": "Solid", "value": "btn-primary", "label": "Primary" },
            { "group": "Solid", "value": "btn-secondary", "label": "Secondary" },
            { "group": "Solid", "value": "btn-white", "label": "White" },
            { "group": "Light", "value": "btn-light-primary", "label": "Primary" },
            { "group": "Light", "value": "btn-light-secondary", "label": "Secondary" },
            { "group": "Light", "value": "btn-light-white", "label": "White" },
            { "group": "Outline", "value": "btn-outline-primary", "label": "Primary" },
            { "group": "Outline", "value": "btn-outline-secondary", "label": "Secondary" },
            { "group": "Outline", "value": "btn-outline-white", "label": "White" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Countdown",
      "blocks": [
        {
          "type": "countdown"
        },
        {
          "type": "text",
          "settings": {
            "subtitle": "Optional Subtitle",
            "title": "Countdown",
            "description": "<p>Use this section to showcase your latest offers that require a sense of urgency.</p>",
            "btn_primary_text": "Primary button",
            "btn_secondary_text": "Secondary button"
          }
        }
      ]
    }
  ]
}
{% endschema %}