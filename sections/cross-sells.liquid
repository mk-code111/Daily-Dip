{% liquid
  assign total_price = 0
  assign total_compare_price = 0
%}

<cross-sells
  id="cross-sells-{{ section.id }}" 
  class="
    cross-sells 
    {{ section.settings.bg_color }}
    {{ section.settings.text_color }}
    {{ section.settings.border_top_width | prepend: 'border-top-' }}
    {{ section.settings.border_bottom_width | prepend: 'border-bottom-' }}
    {{ section.settings.border_color }} 
    {{ section.settings.pt | prepend: 'pt-' }} 
    {{ section.settings.pb | prepend: 'pb-' }}
  "
  style="
    --bs-bg-opacity: {{ section.settings.bg_opacity | append: '%' }};
    --bs-border-opacity: {{ section.settings.border_opacity | append: '%' }};
    background-image: linear-gradient({{ section.settings.bg_gradient_direction | append: 'deg' }}, rgba(var(--text-color-rgb), {{ section.settings.bg_gradient_opacity | append: '%'}}), rgba(var(--text-color-rgb), 0));
  ">
  <div 
    class="container" 
    style="max-width: {{ section.settings.container_max_width }}px">
    <div class="d-desktop-none">
      {% render 'section-header' %}
    </div>
    <div class="row align-items-desktop-center">
      <div class="col-18 col-desktop-12 mb-8 mb-desktop-0">
        <div
          class="product-list m-n4 mt-n1 row row-cols-1 row-cols-tablet-2 justify-content-center" 
          aria-label="{{ section.settings.header_title | strip_html }}"
          role="list">
          {% for block in section.blocks %}
            {% assign product = block.settings.product %}
            {% if product and product.id %}
              {% liquid 
                assign total_price = total_price | plus: product.first_available_variant.price
                assign total_compare_price = total_compare_price | plus: product.first_available_variant.compare_at_price
              %}
              <div class="p-4" role="listitem">
                <div 
                  class="product-card"
                  data-is-selected="{% if product.available %}true{% else %}false{% endif %}">
                  <div class="row align-items-center mx-n3">
                    <div class="col-6 col-desktop-8 px-3">
                      <a href="{{ product.url }}">
                        <div class="img-wrapper product-card-img-wrapper">
                          {% render 'product-custom-badge', product: product %}
                          {% render 'product-sale-badge', product: product %}
                          {% render 'image-url', img: product.featured_image, ratio: settings.product_card_img_ratio, class: settings.product_card_img_border %}
                        </div>
                      </a>
                    </div>
                    <div class="col-12 col-desktop-10 px-3">
                      <a href="{{ product.url }}" class="product-card-link" tabindex="-1">
                        <h3 class="product-card-title product-title {{ settings.product_card_title_font_size }}">
                          {{ product.title }}
                        </h3>
                        {% render 'product-rating-badge', product: product %}
                        {% if product.has_only_default_variant %}
                          {% render 'product-card-price', product: product %}
                        {% endif %}
                      </a>
                      {% if product.has_only_default_variant %}
                        <input 
                          type="hidden" 
                          name="variant-id" 
                          value="{{ product.first_available_variant.id }}"
                          data-price="{{ product.first_available_variant.price }}"
                          data-compare-at-price="{{ product.first_available_variant.compare_at_price }}">
                      {% else %}
                        <select 
                          class="form-select form-select-sm mt-5 mb-4 w-auto"
                          name="variant-id" 
                          aria-label="{{ 'product.select_variant' | t }}">
                          {% unless product.available %}
                            <option>
                              {{ 'product.sold_out' | t }}
                            </option>
                          {% endunless %}
                          {% for variant in product.variants %}
                            <option 
                              value="{{ variant.id }}" 
                              data-price="{{ variant.price }}"
                              data-compare-at-price="{{ variant.compare_at_price }}"
                              data-variant-image="{%- if variant.image -%}{%- render 'image-url', img: variant.image, ratio: settings.product_card_img_ratio, only_src: true -%}{%- endif -%}"
                              {% unless variant.available %}disabled{% endunless %}>
                              {{ variant.title }} - {{ variant.price | money_without_trailing_zeros }}
                            </option>
                          {% endfor %}
                        </select>
                      {% endif %}
                      <div class="form-check">
                        <input 
                          id="cross-sells-selector-{{ product.id }}"
                          class="form-check-input" 
                          type="checkbox" 
                          value="{{ product.first_available_variant.id }}"
                          {% unless product.available %}disabled{% endunless %}
                          {% if product.available %}checked{% endif %}>
                        <label class="form-check-label" for="cross-sells-selector-{{ product.id }}">
                          {% if product.available == false %}
                            {{ 'product.cross_sells.sold_out' | t }}
                          {% else %}
                            {{ 'product.cross_sells.select_this' | t }}
                          {% endif %}
                        </label>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            {% else %}
              {% liquid 
                if forloop.index <= 6
                  assign img_placeholdeer = 'product-' | append: forloop.index
                else
                  assign img_placeholdeer = 'product-1'
                endif
              %}
              <div class="p-4" role="listitem">
                <div 
                  class="product-card">
                  <div class="row align-items-center mx-n3">
                    <div class="col-6 col-desktop-8 px-3">
                      <div class="img-wrapper product-card-img-wrapper">
                        {{ img_placeholdeer | placeholder_svg_tag: 'img-thumbnail' }}
                      </div>
                    </div>
                    <div class="col-12 col-desktop-10 px-3">
                      <h3 class="product-card-title product-title {{ settings.product_card_title_font_size }}">
                        Product title {{ forloop.index }}
                      </h3>
                    </div>
                  </div>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
      <div class="col-18 col-desktop-6">
        <div class="d-none d-desktop-block pb-4">
          {% render 'section-header' %}
        </div>
        <div class="cross-sells-footer text-center pt-7 pt-desktop-9">
          <p class="cross-sells-footer-total-price fs-lg mb-4" role="alert" aria-atomic="true">
            {{ 'product.cross_sells.total_price' | t }}:
            <s class="me-2 opacity-70" {% if total_compare_price <= total_price %}hidden{% endif %}>
              <span class="visually-hidden">
                {{ 'product.regular_price' | t }} 
              </span>
              <span data-total-compare-price>
                {{ total_compare_price | money_without_trailing_zeros }}
              </span>
            </s>
            <b data-total-price>
              {{ total_price | money_without_trailing_zeros }}
            </b>
          </p>
          <p class="cross-sells-footer-total-savings fs-lg mt-n5 mb-4 fst-italic" {% if total_compare_price <= total_price %}hidden{% endif %}>
            {{ 'product.cross_sells.total_savings' | t }}:
            <span data-total-savings>
              {{ total_compare_price | minus: total_price | money_without_trailing_zeros }}
            </span>
          </p>
          <button 
            class="btn btn-atc text-nowrap {{ section.settings.atc_btn_color }} {{ section.settings.atc_btn_size }}"
            {% if total_price == 0 %}disabled{% endif %}>
            {{ 'product.cross_sells.add_selected_to_cart' | t }}
          </button> 
        </div>
      </div>
    </div>
  </div>
</cross-sells>

{% schema %}
{
  "name": "Cross-sells",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Styling"
    },
    {
      "type": "select",
      "id": "bg_color",
      "label": "Background color",
      "default": "bg-body",
      "options": [
        { "value": "bg-primary", "label": "Primary" },
        { "value": "bg-secondary", "label": "Secondary" },
        { "value": "bg-body", "label": "Body" },
        { "value": "bg-white", "label": "White" }
      ]
    },
    {
      "type": "range",
      "id": "bg_opacity",
      "label": "Background opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 100,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "bg_gradient_opacity",
      "label": "Background gradient opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 0,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "bg_gradient_direction",
      "label": "Background gradient direction",
      "min": 0,
      "max": 360,
      "step": 15,
      "default": 180,
      "unit": "deg"
    },
    {
      "type": "select",
      "id": "text_color",
      "label": "Text color",
      "default": "text-body",
      "options": [
        { "value": "text-primary", "label": "Primary" },
        { "value": "text-secondary", "label": "Secondary" },
        { "value": "text-body", "label": "Body" },
        { "value": "text-white", "label": "White" }
      ]
    },
    {
      "type": "range",
      "id": "border_top_width",
      "label": "Border top width",
      "default": 0,
      "min": 0,
      "max": 16,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "border_bottom_width",
      "label": "Border bottom width",
      "default": 0,
      "min": 0,
      "max": 16,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "border_color",
      "label": "Border color",
      "default": "border-body",
      "options": [
        { "value": "border-primary", "label": "Primary" },
        { "value": "border-secondary", "label": "Secondary" },
        { "value": "border-body", "label": "Body" },
        { "value": "border-white", "label": "White" }
      ]
    },
    {
      "type": "range",
      "id": "border_opacity",
      "label": "Border opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 100,
      "unit": "%"
    },
    {
      "type": "text",
      "id": "container_max_width",
      "label": "Container max-width (px)",
      "info": "Leave empty to use the global container width"
    },
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "header_title",
      "label": "Title",
      "default": "Frequently Bought Together"
    },
    {
      "type": "select",
      "id": "header_title_font_size",
      "label": "Title font-size",
      "default": "h2",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ]
    },
    {
      "type": "richtext",
      "id": "header_description",
      "label": "Description (optional)",
      "default": "<p>Add on optional description for this section</p>"
    },
    {
      "type": "select",
      "id": "header_description_font_size",
      "label": "Description font-size",
      "default": "fs-md",
      "options": [
        { "value": "fs-sm", "label": "sm" },
        { "value": "fs-md", "label": "md" },
        { "value": "fs-lg", "label": "lg" },
        { "value": "fs-xl", "label": "xl" },
        { "value": "fs-xxl", "label": "xxl" }
      ]
    },
    {
      "type": "header",
      "content": "\"Add to cart\" button"
    },
    {
      "type": "select",
      "id": "atc_btn_color",
      "label": "Button color",
      "default": "btn-primary",
      "options": [
        { "group": "Solid", "value": "btn-primary", "label": "Primary" },
        { "group": "Solid", "value": "btn-secondary", "label": "Secondary" },
        { "group": "Solid", "value": "btn-white", "label": "White" },
        { "group": "Light", "value": "btn-light-primary", "label": "Primary" },
        { "group": "Light", "value": "btn-light-secondary", "label": "Secondary" },
        { "group": "Light", "value": "btn-light-white", "label": "White" },
        { "group": "Outline", "value": "btn-outline-primary", "label": "Primary" },
        { "group": "Outline", "value": "btn-outline-secondary", "label": "Secondary" },
        { "group": "Outline", "value": "btn-outline-white", "label": "White" }
      ]
    },
    {
      "type": "select",
      "id": "atc_btn_size",
      "label": "Button size",
      "default": "",
      "options": [
        { "value": "btn-sm", "label": "Small" },
        { "value": "", "label": "Medium" },
        { "value": "btn-lg", "label": "Large" }
      ]
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Top",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 10
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Bottom",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 10
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "Leave empty to show the current product (Only if used on the product page)"
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "presets": [
    {
      "name": "Cross-sells",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}