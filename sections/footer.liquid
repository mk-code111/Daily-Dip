{% liquid 
  assign footer_about_block = section.blocks | where: 'type', 'about' | first
  assign newsletter_block = section.blocks | where: 'type', 'newsletter' | first
%}

<footer 
  id="footer" 
  class="
    {{ section.settings.bg_color }} 
    {{ section.settings.text_color }} 
    {{ section.settings.border_top_width | prepend: 'border-top-' }}
    {{ section.settings.border_bottom_width | prepend: 'border-bottom-' }}
    {{ section.settings.border_color }} 
    {{ section.settings.pt | prepend: 'pt-' }} 
    {{ section.settings.pb | prepend: 'pb-' }}
    "
  style="
    --bs-bg-opacity: {{ section.settings.bg_opacity | append: '%' }};
    --bs-border-opacity: {{ section.settings.border_opacity | append: '%' }};
    background-image: linear-gradient({{ section.settings.bg_gradient_direction | append: 'deg' }}, rgba(var(--text-color-rgb), {{ section.settings.bg_gradient_opacity | append: '%'}}), rgba(var(--text-color-rgb), 0));
  ">
  <div class="container">
    <div
      id="footer-mobile" 
      class="d-desktop-none">
      {% if newsletter_block != nil %}
        <div class="mb-9">
          {% render 'footer-newsletter', block: newsletter_block %}
        </div>
      {% endif %}
      {% if footer_about_block != nil %}
        <div class="mb-9">
          {% render 'footer-about', block: footer_about_block, suffix: 'mobile' %}
        </div>
      {% endif %}
      <div class="mb-8" role="list">
        {% for block in section.blocks %}
          {% if block.type == 'menu' or block.type == 'richtext' %}
            <div class="collapse-wrapper" role="listitem" {{ block.shopify_attributes }}>
              <button
                id="footer-mobile-collapse-btn-{{ forloop.index }}" 
                class="heading fs-md" 
                type="button" 
                data-bs-toggle="collapse" 
                data-bs-target="#footer-mobile-collapse-{{ forloop.index }}" 
                aria-expanded="false" 
                aria-controls="footer-mobile-collapse-{{ forloop.index }}">
                {{ block.settings.title }}
                {% render 'svg-icons', icon: 'chevron-down', size: 18, stroke_width: 1.5 %}
              </button>
              <div id="footer-mobile-collapse-{{ forloop.index }}" class="collapse">
                <div class="collapse-inner">
                  {% render 'footer-block', block: block %}
                </div>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
    <div 
      id="footer-desktop" 
      class="d-none d-desktop-block">
      <div class="row mx-n9">
        {% if footer_about_block != nil %}
          <div class="col-6 px-9">
            {% render 'footer-about', block: footer_about_block, suffix: 'desktop' %}
          </div>
        {% endif %}
        <div class="px-9 {% if footer_about_block == nil %}col-18{% else %}col-12{% endif %}">
          {% if newsletter_block != nil %}
            <div class="mt-2 mb-10">
              {% render 'footer-newsletter', block: newsletter_block %}
            </div>
          {% endif %}
          <div class="row" role="list">
            {% for block in section.blocks %}
              {% if block.type == 'menu' or block.type == 'richtext' %}
                <div class="footer-block col" role="listitem" {{ block.shopify_attributes }}>
                  <h3 class="title mb-3 {{ block.settings.title_font_size }}">
                    <span>
                      {{ block.settings.title }}
                    </span>
                  </h3>
                  {% render 'footer-block', block: block %}
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </div>
      <hr class="my-8">
    </div>

    <div 
      id="footer-copyright" 
      class="">
      <div class="row align-items-center">
        <div class="col-desktop-5" data-col="1">
          {% if section.settings.show_payment_icons %}
            <div class="payment-icons-wrapper text-center text-desktop-start mt-5 mt-desktop-0">
              {% render 'payment-icons' %}
            </div>
          {% endif %}
        </div>
        <div class="col-desktop-8" data-col="2">
          <div class="fs-sm text-center">
            &copy; {{ 'now' | date: "%Y" }} {{ shop.name | replace: ' (', '<span hidden>' | replace: ')', '</span>' }}.
            {% if section.settings.show_powered_by %}
              <div class="opacity-70">
                Theme by <a href="https://www.jhango.com" target="_blank" rel="sponsored">Jhango</a>,
                Powered by <a href="https://www.shopify.com" target="_blank" rel="sponsored">Shopify</a>
              </div>
            {% endif %}
          </div>
        </div>
        <div class="col-desktop-5" data-col="3">
          {% if section.settings.show_scroll_top_btn %}
            <div class="text-center text-desktop-end mt-7 mt-desktop-0">
              <button 
                id="footer-btn-scroll-top" 
                class="btn"
                onclick="document.documentElement.scrollTo({ top: 0, behavior: 'smooth'})">
                <div class="me-4 ms-n2" aria-hidden="true">
                  {% render 'svg-icons', icon: 'arrow-top', size: 20, stroke_width: 1.5 %}
                </div>
                {{ 'general.accessibility.scroll_to_top' | t }}
              </button>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
    
  </div>
</footer>

