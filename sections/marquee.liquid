        { "value": "bs-primary", "label": "Primary" },
        { "value": "bs-secondary", "label": "Secondary" },
        { "value": "bs-body-color", "label": "Body" }
      ]
    },
    {
      "type": "range",
      "id": "separator_icon_opacity",
      "label": "Icon opacity",
      "default": 100,
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "info": "Spacing between items",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Padding top",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 4
    },
    {
