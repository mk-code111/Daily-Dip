{% liquid
  assign variants_json = product.variants | json
%}

<section
  id="product-main-v2-{{ product.id }}"
  class="
    product-main product-main-v2
    {{ section.settings.bg_color }}
    {{ section.settings.text_color }}
    {{ section.settings.border_top_width | prepend: 'border-top-' }}
    {{ section.settings.border_bottom_width | prepend: 'border-bottom-' }}
    {{ section.settings.border_color }}
    {{ section.settings.pt | prepend: 'pt-0 pt-tablet-' }}
    {{ section.settings.pb | prepend: 'pb-' }}
  "
  style="
    --bs-bg-opacity: {{ section.settings.bg_opacity | append: '%' }};
    --bs-border-opacity: {{ section.settings.border_opacity | append: '%' }};
    --v2-ink: {{ section.settings.outline_color }};
    --v2-green: {{ section.settings.accent_green }};
    --v2-lime: {{ section.settings.accent_lime }};
    --v2-yellow: {{ section.settings.accent_yellow }};
    --v2-red: {{ section.settings.accent_red }};
    --v2-d: {{ section.settings.shadow_depth }}px;
    background-image: linear-gradient({{ section.settings.bg_gradient_direction | append: 'deg' }}, rgba(var(--text-color-rgb), {{ section.settings.bg_gradient_opacity | append: '%'}}), rgba(var(--text-color-rgb), 0));
  ">
  <div class="container" style="max-width: {{ section.settings.container_max_width | append: 'px' }};">
    <div
      class="product-contents position-relative"
      data-quick-view-contents
      data-recently-viewed-set
      data-product-url="{{ product.url }}">
      <a class="visually-hidden-focusable" href="#product-inner-v2-{{ product.id }}">
        {{ 'general.accessibility.skip_product_content' | t }}
      </a>
      <div class="row">
        <div class="col-desktop-9 mb-5 mb-desktop-0">
          {% render 'product-block-media-gallery' %}
        </div>
        <div class="col-desktop-9">
          <div id="product-inner-v2-{{ product.id }}">
            <product-form>
              {% form 'product', product, data-productid: product.id, data-product-url: product.url, data-variants: variants_json %}
                <input type="hidden" name="id" data-productid="{{ product.id }}" value="{{ product.selected_or_first_available_variant.id }}">
                {% liquid
                  for block in section.blocks
                    case block.type
                      when 'title'
                        render 'product-block-title', block: block
                      when 'price'
                        render 'product-block-price', block: block, form: form
                      when 'options'
                        render 'product-block-options', block: block, form: form
                      when 'pack_selector'
                        render 'product-block-pack-selector', block: block, form: form
                      when 'atc_button'
                        render 'product-block-atc-button', block: block, form: form
                      when 'richtext'
                        render 'product-block-richtext', block: block
                      when 'collapse'
                        render 'product-block-collapse', block: block
                      when 'liquid'
                        render 'product-block-liquid', block: block
                      when 'trust_icons'
                        render 'product-block-trust-icons', block: block
                      when 'breadcrumb'
                        render 'product-block-breadcrumb', block: block
                      when 'separator'
                        render 'product-block-separator', block: block
                      when 'stock_indicator'
                        render 'product-block-stock-indicator', block: block
                      when 'quantity_breaks'
                        render 'product-block-quantity-breaks', block: block
                      when 'cross_sells'
                        render 'product-block-cross-sells', block: block
                      when '@app'
                        render block
                    endcase
                  endfor
                %}
              {% endform %}
            </product-form>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
/* ===== Product main v2 — chunky 3D style (scoped, base CSS untouched) ===== */
.product-main-v2{--v2-card:#fff}
.product-main-v2 .img-thumbnail{border:3px solid var(--v2-ink)!important;border-radius:18px!important;box-shadow:var(--v2-d) var(--v2-d) 0 var(--v2-ink);background:var(--v2-card)}
.product-main-v2 .swiper-button-prev,.product-main-v2 .swiper-button-next{background:var(--v2-card);color:var(--v2-ink);border:2.5px solid var(--v2-ink);border-radius:12px;box-shadow:2px 2px 0 var(--v2-ink)}
.product-main-v2 h1,.product-main-v2 h2,.product-main-v2 .heading{font-weight:700;line-height:1.1}

/* Price */
.product-main-v2 .product-price-3d-badge{--price-badge-face:var(--v2-green);--price-badge-bottom:var(--v2-ink);--price-badge-depth:3px;--price-badge-radius:14px;border:3px solid var(--v2-ink);padding:4px 14px;font-weight:800}
.product-main-v2 .product-price-compare{color:var(--v2-red)!important;font-weight:700}
.product-main-v2 .product-sale-badge--outlined{background:var(--v2-lime)!important;color:var(--v2-ink)!important;border:2px solid var(--v2-ink)!important;border-radius:999px!important;box-shadow:2px 2px 0 var(--v2-ink)!important;transform:rotate(-3deg);padding:5px 14px!important;font-size:14px!important;gap:6px!important}
.product-main-v2 .product-sale-badge--outlined .product-sale-badge__text{color:var(--v2-ink)!important}
.product-main-v2 .product-sale-badge--outlined .product-sale-badge__leaf{width:18px!important;height:18px!important;min-width:18px!important;flex-basis:18px!important}

/* Stock bar */
.product-main-v2 .progress{border:2px solid var(--v2-ink);border-radius:99px;background:var(--v2-card);overflow:hidden}

/* Pack selector (selectors target common class patterns; tune to snippet markup) */
.product-main-v2 [class*="pack-selector"] label,
.product-main-v2 [class*="pack-card"],
.product-main-v2 [class*="pack-option"]{background:var(--v2-card);border:3px solid var(--v2-ink)!important;border-radius:20px!important;box-shadow:var(--v2-d) var(--v2-d) 0 var(--v2-ink);transition:transform .12s,box-shadow .12s,background .12s;cursor:pointer}
.product-main-v2 [class*="pack-selector"] label:hover,
.product-main-v2 [class*="pack-card"]:hover{transform:translate(-1px,-1px)}
.product-main-v2 [class*="pack-selector"] input:checked + label,
.product-main-v2 [class*="pack-card"].active,
.product-main-v2 [class*="pack-card"].is-active,
.product-main-v2 [class*="pack-option"].active{background:var(--v2-lime);color:var(--v2-ink);transform:translate(3px,3px);box-shadow:1px 1px 0 var(--v2-ink)}
.product-main-v2 [class*="pack"] [class*="badge"]{background:var(--v2-yellow);color:var(--v2-ink);border:2.5px solid var(--v2-ink);border-radius:99px;font-weight:700;box-shadow:none}

/* Quantity */
.product-main-v2 .qty-input-wrapper .form-control{border:3px solid var(--v2-ink);border-radius:16px;font-weight:700;background:var(--v2-card)}

/* Add to cart / Buy now — 3D press buttons */
.product-main-v2 .product-block-atc .btn-atc,
.product-main-v2 .product-block-atc .btn-buy{border:3px solid var(--v2-ink)!important;border-radius:16px!important;box-shadow:0 6px 0 var(--v2-ink)!important;font-weight:700;letter-spacing:.04em;position:relative;top:0;transition:top .08s,box-shadow .08s}
.product-main-v2 .product-block-atc .btn-atc{background:var(--v2-green)!important;color:#fff!important}
.product-main-v2 .product-block-atc .btn-buy{background:var(--v2-yellow)!important;color:var(--v2-ink)!important}
.product-main-v2 .product-block-atc .btn-atc:active:not(:disabled),
.product-main-v2 .product-block-atc .btn-buy:active:not(:disabled){top:5px;box-shadow:0 1px 0 var(--v2-ink)!important}

/* Trust icons (guessed class pattern) */
.product-main-v2 [class*="trust-icon"] > *{background:var(--v2-card);border:2.5px solid var(--v2-ink);border-radius:16px;box-shadow:3px 3px 0 var(--v2-ink);padding:.6rem .25rem}

/* Collapse -> chunky cards */
.product-main-v2 .collapse-wrapper{border:3px solid var(--v2-ink)!important;border-radius:16px;background:var(--v2-card);padding:0 16px;margin-bottom:12px;box-shadow:3px 3px 0 var(--v2-ink)}
.product-main-v2 .collapse-wrapper [data-bs-toggle=collapse]{font-weight:700}
.product-main-v2 .collapse-wrapper svg.svg-icon-chevron-down{background:var(--v2-lime);color:var(--v2-ink);border:2.5px solid var(--v2-ink);border-radius:50%;padding:3px;width:28px;height:28px;box-shadow:2px 2px 0 var(--v2-ink)}

@media (prefers-reduced-motion:reduce){.product-main-v2 *{transition:none!important}}
{% endstylesheet %}

