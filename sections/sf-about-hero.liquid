{%- comment -%}
  sf-about-hero — brand banner that opens the About page.
  Deep green card: story copy, buttons and stat stickers on one side,
  a floating stack of up to 4 product photos with a spinning badge on the other.
  Styles: assets/sf-about.css
{%- endcomment -%}
{{ 'sf-pdp.css' | asset_url | stylesheet_tag }}
{{ 'sf-about.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign stats = section.blocks | where: 'type', 'stat'
-%}
<style>
  #shopify-section-{{ section.id }} {
    --sf-ah-page: {{ s.c_page }};
    --sf-ah-bg: {{ s.c_bg }};
    --sf-ah-ink: {{ s.c_text }};
    --sf-ah-pt: {{ s.pt }}px;
    --sf-ah-pb: {{ s.pb }}px;
  }
</style>

<section class="sf-pdp sf-ah{% if s.float == false %} sf-ah--still{% endif %}">
  <div class="sf-pdp__wrap">
    <div class="sf-ah__card">
      <svg class="sf-ah__leaf sf-ah__leaf--a" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19c0-8 5-13 14-14-1 9-6 14-14 14z"/></svg>
      <svg class="sf-ah__leaf sf-ah__leaf--b" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19c0-8 5-13 14-14-1 9-6 14-14 14z"/></svg>
      <svg class="sf-ah__leaf sf-ah__leaf--c" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19c0-8 5-13 14-14-1 9-6 14-14 14z"/></svg>

      <div class="sf-ah__copy">
        {%- if s.eyebrow != blank -%}<p class="sf-ah__eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
        {%- if s.title != blank -%}<h1 class="sf-ah__title">{{ s.title }}</h1>{%- endif -%}
        {%- if s.text != blank -%}<div class="sf-ah__text">{{ s.text }}</div>{%- endif -%}

        {%- if s.btn1_label != blank or s.btn2_label != blank -%}
          <div class="sf-ah__btns">
            {%- if s.btn1_label != blank -%}
              <a class="sf-ah__btn sf-ah__btn--main" href="{{ s.btn1_url | default: routes.all_products_collection_url }}">{{ s.btn1_label | escape }}</a>
            {%- endif -%}
            {%- if s.btn2_label != blank -%}
              <a class="sf-ah__btn sf-ah__btn--ghost" href="{{ s.btn2_url | default: '#our-story' }}">{{ s.btn2_label | escape }}
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6"/></svg>
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if stats.size > 0 -%}
          <ul class="sf-ah__stats" role="list">
            {%- for b in stats -%}
              <li class="sf-ah__stat" {{ b.shopify_attributes }} style="--sf-ah-stat: {{ b.settings.tint }};">
                <strong>{{ b.settings.value | escape }}</strong><span>{{ b.settings.label | escape }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <div class="sf-ah__art">
        <div class="sf-ah__stack">
          {%- for i in (1..4) -%}
            {%- liquid
              assign key = 'img_' | append: i
              assign img = s[key]
              assign fb = 'sf-about-hero-' | append: i | append: '.jpg'
            -%}
            {%- if img != blank or s.use_starter -%}
              <figure class="sf-ah__photo sf-ah__photo--{{ i }}">
                {%- if img != blank -%}
                  {{ img | image_url: width: 900 | image_tag: loading: 'eager', widths: '300, 450, 600, 900', sizes: '(min-width: 990px) 280px, 46vw', alt: img.alt, class: 'sf-ah__img' }}
                {%- else -%}
                  <img class="sf-ah__img" src="{{ fb | asset_url }}" alt="" width="900" height="900" loading="eager">
                {%- endif -%}
              </figure>
            {%- endif -%}
          {%- endfor -%}
          {%- if s.badge != blank -%}
            <div class="sf-ah__badge" aria-hidden="true">
              <svg viewBox="0 0 150 150"><defs><path id="sfAhCirc-{{ section.id }}" d="M75 75 m-50 0 a50 50 0 1 1 100 0 a50 50 0 1 1 -100 0"/></defs><circle cx="75" cy="75" r="71" /><text><textPath href="#sfAhCirc-{{ section.id }}">{{ s.badge | escape }} · {{ s.badge | escape }} ·</textPath></text></svg>
              <span class="sf-ah__badge-ico">
                <svg viewBox="0 0 24 24"><path d="M4 10h13v4a6 6 0 0 1-6 6h-1a6 6 0 0 1-6-6z"/><path d="M17 11h1.5a2.5 2.5 0 0 1 0 5H17"/><path d="M8 3c-1 1.2 1 2 0 3.2M12 3c-1 1.2 1 2 0 3.2"/></svg>
              </span>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "SF · About banner",
  "tag": "div",
  "class": "sf-ah-section",
  "max_blocks": 4,
  "settings": [
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Our story" },
    { "type": "inline_richtext", "id": "title", "label": "Title", "default": "Goodness in <em>every sip</em>", "info": "Italic words get the lime highlight." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Dailydip started with a simple idea: everyday herbal blends that actually make you feel good. Here's how every cup gets from the farm to your kettle.</p>" },

    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "btn1_label", "label": "Main button", "default": "Shop our blends" },
    { "type": "url", "id": "btn1_url", "label": "Main button link" },
    { "type": "text", "id": "btn2_label", "label": "Second button", "default": "See the journey" },
    { "type": "text", "id": "btn2_url", "label": "Second button link", "default": "#our-story", "info": "#our-story jumps to the first story step." },

    { "type": "header", "content": "Photos" },
    { "type": "image_picker", "id": "img_1", "label": "Photo 1 (front)" },
    { "type": "image_picker", "id": "img_2", "label": "Photo 2" },
    { "type": "image_picker", "id": "img_3", "label": "Photo 3" },
    { "type": "image_picker", "id": "img_4", "label": "Photo 4" },
    { "type": "checkbox", "id": "use_starter", "label": "Fill empty photos with the starter product shots", "default": true },
    { "type": "text", "id": "badge", "label": "Spinning badge text", "default": "LET'S DIP", "info": "Leave empty to hide." },
    { "type": "checkbox", "id": "float", "label": "Floating photos", "default": true },

    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "c_page", "label": "Page background", "default": "#fbf8ef" },
    { "type": "color", "id": "c_bg", "label": "Banner background", "default": "#1f7a35" },
    { "type": "color", "id": "c_text", "label": "Banner text", "default": "#fbf8ef" },

    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "pt", "label": "Top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 16 },
    { "type": "range", "id": "pb", "label": "Bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24 }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Sticker",
      "settings": [
        { "type": "text", "id": "value", "label": "Big text", "default": "4" },
        { "type": "text", "id": "label", "label": "Small text", "default": "Daily blends" },
        { "type": "color", "id": "tint", "label": "Colour", "default": "#c8f169" }
      ]
    }
  ],
  "presets": [
    {
      "name": "SF · About banner",
      "blocks": [
        { "type": "stat", "settings": { "value": "4", "label": "Daily blends", "tint": "#c8f169" } },
        { "type": "stat", "settings": { "value": "Farm", "label": "to cup", "tint": "#ffd23f" } },
        { "type": "stat", "settings": { "value": "Free", "label": "shipping", "tint": "#ffffff" } }
      ]
    }
  ]
}
{% endschema %}
