{%- comment -%}
  sf-about-steps — "From farm to cup" process steps for the About page.
  Each step block: number blob, title, short text, doodle icon and a
  floating framed image (same float as the product banner heading).
  All text lives in settings, never inside the images.
  Styles: assets/sf-about.css
{%- endcomment -%}
{{ 'sf-pdp.css' | asset_url | stylesheet_tag }}
{{ 'sf-about.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign steps = section.blocks | where: 'type', 'step'
-%}
<style>
  #shopify-section-{{ section.id }} {
    --sf-ab-bg: {{ s.c_bg }};
    --sf-ab-card: {{ s.c_card }};
    --sf-ab-pt: {{ s.pt }}px;
    --sf-ab-pb: {{ s.pb }}px;
    --sf-ab-ratio: {{ s.ratio }};
  }
</style>

<section class="sf-pdp sf-ab{% if s.float == false %} sf-ab--still{% endif %}">
  <div class="sf-pdp__wrap">
    {%- if s.eyebrow != blank or s.title != blank or s.text != blank -%}
      <div class="sf-ab__head">
        {%- if s.eyebrow != blank -%}<p class="sf-ab__eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
        {%- if s.title != blank -%}<h2 class="sf-ab__title">{{ s.title }}</h2>{%- endif -%}
        {%- if s.text != blank -%}<div class="sf-ab__text">{{ s.text }}</div>{%- endif -%}
      </div>
    {%- endif -%}

    {%- if steps.size > 0 -%}
      <ol class="sf-ab__steps sf-ab__steps--n{{ steps.size }}" role="list">
        {%- for b in steps -%}
          {%- liquid
            assign bs = b.settings
            assign num = bs.number
            if num == blank
              if forloop.index < 10
                assign num = '0' | append: forloop.index
              else
                assign num = forloop.index
              endif
            endif
            assign num_ink = '#1c1c1c'
            assign bright = bs.tint | color_brightness
            if bright < 150
              assign num_ink = '#ffffff'
            endif
            assign fallback = 'sf-about-step-' | append: forloop.index | append: '.jpg'
          -%}
          <li class="sf-ab__step" {{ b.shopify_attributes }} style="--sf-ab-tint: {{ bs.tint }}; --sf-ab-num-ink: {{ num_ink }}; --sf-ab-delay: {{ forloop.index0 | times: -0.9 }}s;">
            <div class="sf-ab__top">
              <span class="sf-ab__num" aria-hidden="true">{{ num | escape }}</span>
              <div class="sf-ab__copy">
                <h3 class="sf-ab__stitle"><span class="visually-hidden">Step {{ forloop.index }}: </span>{{ bs.title | escape }}</h3>
                {%- if bs.text != blank -%}<p class="sf-ab__stext">{{ bs.text | escape }}</p>{%- endif -%}
              </div>
              {%- if bs.icon != 'none' -%}
                <span class="sf-ab__ico" aria-hidden="true">
                  <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                    {%- case bs.icon -%}
                      {%- when 'leaf' -%}
                        <path d="M24 40c-9-5-12-15-6-28 9 6 13 16 6 28z"/><path d="M24 40c-1-8-2-15-6-22"/>
                      {%- when 'sparkle' -%}
                        <path d="M22 10c1.5 8 5 11.5 13 13-8 1.5-11.5 5-13 13-1.5-8-5-11.5-13-13 8-1.5 11.5-5 13-13z"/><path d="M37 8v6M34 11h6"/>
                      {%- when 'box' -%}
                        <path d="M10 17l14-7 14 7v16l-14 7-14-7z"/><path d="M10 17l14 7 14-7M24 24v16"/><path d="M17 13.5l14 7"/>
                      {%- when 'truck' -%}
                        <path d="M14 14h17v16H14zM31 20h6l4 5v5H31"/><circle cx="19" cy="32" r="3"/><circle cx="35" cy="32" r="3"/><path d="M4 18h6M6 23h5M3 28h6"/>
                      {%- when 'cup' -%}
                        <path d="M10 20h22v7a9 9 0 0 1-9 9h-4a9 9 0 0 1-9-9z"/><path d="M32 22h3a4 4 0 0 1 0 8h-3"/><path d="M17 8c-2 2.5 2 4 0 7M24 8c-2 2.5 2 4 0 7"/>
                      {%- when 'heart' -%}
                        <path d="M24 38S9 29 9 19a7.5 7.5 0 0 1 15-2 7.5 7.5 0 0 1 15 2c0 10-15 19-15 19z"/>
                      {%- when 'hand' -%}
                        <path d="M6 30h7l8 3h8a3 3 0 0 0 0-6h-6"/><path d="M13 36l9 4 18-8a3 3 0 0 0-2.5-5.5L29 30"/><path d="M28 20c-5-3-6-8-3-14 6 3 7 9 3 14z"/>
                    {%- endcase -%}
                  </svg>
                  <i class="sf-ab__dash sf-ab__dash--a"></i><i class="sf-ab__dash sf-ab__dash--b"></i><i class="sf-ab__dash sf-ab__dash--c"></i>
                </span>
              {%- endif -%}
            </div>

            <div class="sf-ab__media">
              <div class="sf-ab__frame">
                {%- if bs.image != blank -%}
                  {{ bs.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '360, 540, 720, 960, 1200', sizes: '(min-width: 1100px) 300px, (min-width: 750px) 45vw, 92vw', alt: bs.image.alt | default: bs.title, class: 'sf-ab__img' }}
                {%- elsif forloop.index <= 4 -%}
                  <img class="sf-ab__img" src="{{ fallback | asset_url }}" alt="{{ bs.title | escape }}" width="732" height="378" loading="lazy">
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'sf-ab__img sf-ab__img--ph' }}
                {%- endif -%}
              </div>
            </div>
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "SF · Our process",
  "tag": "div",
  "class": "sf-ab-section",
  "max_blocks": 6,
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "How we work" },
    { "type": "inline_richtext", "id": "title", "label": "Title", "default": "From the farm to your <em>cup</em>", "info": "Wrap a word in italics to give it the lime highlight." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Every Dailydip blend makes the same short trip: hand-picked, cleaned with care, packed fresh and sent straight to your door.</p>" },

    { "type": "header", "content": "Layout" },
    {
      "type": "select", "id": "ratio", "label": "Image shape", "default": "3 / 2",
      "options": [
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 3", "label": "4:3" },
        { "value": "3 / 2", "label": "3:2" },
        { "value": "16 / 9", "label": "Wide 16:9" }
      ]
    },
    { "type": "checkbox", "id": "float", "label": "Floating images", "default": true },

    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "c_bg", "label": "Background", "default": "#fbf8ef" },
    { "type": "color", "id": "c_card", "label": "Card", "default": "#ffffff" },

    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "pt", "label": "Top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "pb", "label": "Bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Use an image without text. Steps 1–4 show a starter illustration until you pick one." },
        { "type": "text", "id": "number", "label": "Number", "info": "Leave empty to number automatically (01, 02…)." },
        { "type": "text", "id": "title", "label": "Title", "default": "Step title" },
        { "type": "text", "id": "text", "label": "Text", "default": "A short line about this step." },
        {
          "type": "select", "id": "icon", "label": "Doodle icon", "default": "leaf",
          "options": [
            { "value": "leaf", "label": "Leaf" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "box", "label": "Box" },
            { "value": "truck", "label": "Truck" },
            { "value": "cup", "label": "Cup" },
            { "value": "heart", "label": "Heart" },
            { "value": "hand", "label": "Hand + leaf" },
            { "value": "none", "label": "None" }
          ]
        },
        { "type": "color", "id": "tint", "label": "Number colour", "default": "#1f7a35" }
      ]
    }
  ],
  "presets": [
    {
      "name": "SF · Our process",
      "blocks": [
        { "type": "step", "settings": { "title": "Picked", "text": "Directly from farmers.", "icon": "leaf", "tint": "#1f7a35" } },
        { "type": "step", "settings": { "title": "Sorted & cleaned", "text": "At our facility.", "icon": "sparkle", "tint": "#ffd23f" } },
        { "type": "step", "settings": { "title": "Packed & stored", "text": "At our facility.", "icon": "box", "tint": "#c8f169" } },
        { "type": "step", "settings": { "title": "Shipped", "text": "Delivered to our valued customers.", "icon": "truck", "tint": "#ff5a4d" } }
      ]
    }
  ]
}
{% endschema %}
