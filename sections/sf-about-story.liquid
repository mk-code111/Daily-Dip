{%- comment -%}
  sf-about-story — one chapter of the brand story / process.
  Add one section per step. Number blob + title + doodle, a lead line, the
  story text, chips and an optional button beside a big floating framed image.
  Image side alternates via a setting. All text is in settings, not in images.
  Styles: assets/sf-about.css
{%- endcomment -%}
{{ 'sf-pdp.css' | asset_url | stylesheet_tag }}
{{ 'sf-about.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign num_ink = '#1c1c1c'
  assign bright = s.tint | color_brightness
  if bright < 150
    assign num_ink = '#ffffff'
  endif
  assign chips = s.chips | split: ','
  assign fb = 'sf-about-step-' | append: s.starter | append: '.jpg'
-%}
<style>
  #shopify-section-{{ section.id }} {
    --sf-as-bg: {{ s.c_bg }};
    --sf-as-tint: {{ s.tint }};
    --sf-as-num-ink: {{ num_ink }};
    --sf-as-ratio: {{ s.ratio }};
    --sf-as-pt: {{ s.pt }}px;
    --sf-as-pb: {{ s.pb }}px;
  }
</style>

<section class="sf-pdp sf-as sf-as--img-{{ s.image_side }}{% if s.float == false %} sf-as--still{% endif %}"{% if s.anchor != blank %} id="{{ s.anchor | handleize }}"{% endif %}>
  {%- if s.connector -%}
    <div class="sf-as__link" aria-hidden="true"><span></span><i><svg viewBox="0 0 24 24"><path d="M12 5v14M6 13l6 6 6-6"/></svg></i></div>
  {%- endif -%}
  <div class="sf-pdp__wrap">
    <div class="sf-as__grid">

      <div class="sf-as__head">
        <div class="sf-as__titlerow">
          {%- if s.number != blank -%}<span class="sf-as__num">{{ s.number | escape }}</span>{%- endif -%}
          <div class="sf-as__titles">
            {%- if s.kicker != blank -%}<p class="sf-as__kicker">{{ s.kicker | escape }}</p>{%- endif -%}
            <h2 class="sf-as__title">{{ s.title | escape }}</h2>
          </div>
          {%- if s.icon != 'none' -%}
            <span class="sf-as__ico" aria-hidden="true">
              <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                {%- case s.icon -%}
                  {%- when 'leaf' -%}<path d="M24 40c-9-5-12-15-6-28 9 6 13 16 6 28z"/><path d="M24 40c-1-8-2-15-6-22"/>
                  {%- when 'sparkle' -%}<path d="M22 10c1.5 8 5 11.5 13 13-8 1.5-11.5 5-13 13-1.5-8-5-11.5-13-13 8-1.5 11.5-5 13-13z"/><path d="M37 8v6M34 11h6"/>
                  {%- when 'box' -%}<path d="M10 17l14-7 14 7v16l-14 7-14-7z"/><path d="M10 17l14 7 14-7M24 24v16"/><path d="M17 13.5l14 7"/>
                  {%- when 'truck' -%}<path d="M14 14h17v16H14zM31 20h6l4 5v5H31"/><circle cx="19" cy="32" r="3"/><circle cx="35" cy="32" r="3"/><path d="M4 18h6M6 23h5M3 28h6"/>
                  {%- when 'cup' -%}<path d="M10 20h22v7a9 9 0 0 1-9 9h-4a9 9 0 0 1-9-9z"/><path d="M32 22h3a4 4 0 0 1 0 8h-3"/><path d="M17 8c-2 2.5 2 4 0 7M24 8c-2 2.5 2 4 0 7"/>
                  {%- when 'heart' -%}<path d="M24 38S9 29 9 19a7.5 7.5 0 0 1 15-2 7.5 7.5 0 0 1 15 2c0 10-15 19-15 19z"/>
                  {%- when 'hand' -%}<path d="M6 30h7l8 3h8a3 3 0 0 0 0-6h-6"/><path d="M13 36l9 4 18-8a3 3 0 0 0-2.5-5.5L29 30"/><path d="M28 20c-5-3-6-8-3-14 6 3 7 9 3 14z"/>
                {%- endcase -%}
              </svg>
              <i class="sf-as__dash sf-as__dash--a"></i><i class="sf-as__dash sf-as__dash--b"></i><i class="sf-as__dash sf-as__dash--c"></i>
            </span>
          {%- endif -%}
        </div>
        {%- if s.lead != blank -%}<p class="sf-as__lead">{{ s.lead | escape }}</p>{%- endif -%}
      </div>

      <div class="sf-as__media">
        <div class="sf-as__blob" aria-hidden="true"></div>
        <div class="sf-as__frame">
          {%- if s.image != blank -%}
            {{ s.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000, 1300, 1600', sizes: '(min-width: 990px) 640px, 92vw', alt: s.image.alt | default: s.title, class: 'sf-as__img' }}
          {%- elsif s.starter != 'none' -%}
            <img class="sf-as__img" src="{{ fb | asset_url }}" alt="{{ s.title | escape }}" width="1464" height="756" loading="lazy">
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'sf-as__img sf-as__img--ph' }}
          {%- endif -%}
          {%- if s.sticker != blank -%}<span class="sf-as__sticker">{{ s.sticker | escape }}</span>{%- endif -%}
        </div>
      </div>

      <div class="sf-as__body">
        {%- if s.story != blank -%}<div class="sf-as__story">{{ s.story }}</div>{%- endif -%}
        {%- if s.chips != blank -%}
          <ul class="sf-as__chips" role="list">
            {%- for c in chips -%}{%- assign c = c | strip -%}{%- if c != blank -%}<li>{{ c | escape }}</li>{%- endif -%}{%- endfor -%}
          </ul>
        {%- endif -%}
        {%- if s.btn_label != blank -%}
          <a class="sf-as__btn" href="{{ s.btn_url | default: routes.all_products_collection_url }}">{{ s.btn_label | escape }}</a>
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "SF · Story step",
  "tag": "div",
  "class": "sf-as-section",
  "settings": [
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "number", "label": "Number", "default": "01", "info": "Leave empty to hide the number blob." },
    { "type": "text", "id": "kicker", "label": "Small label", "default": "Step one" },
    { "type": "text", "id": "title", "label": "Title", "default": "Picked" },
    { "type": "text", "id": "lead", "label": "Short line", "default": "Directly from farmers." },
    { "type": "richtext", "id": "story", "label": "Story", "default": "<p>Tell this part of the story here.</p>" },
    { "type": "text", "id": "chips", "label": "Highlights", "default": "Highlight one, Highlight two", "info": "Comma-separated. Leave empty to hide." },
    { "type": "text", "id": "btn_label", "label": "Button", "info": "Optional. Leave empty to hide." },
    { "type": "url", "id": "btn_url", "label": "Button link" },
    {
      "type": "select", "id": "icon", "label": "Doodle icon", "default": "leaf",
      "options": [
        { "value": "leaf", "label": "Leaf" },
        { "value": "sparkle", "label": "Sparkle" },
        { "value": "box", "label": "Box" },
        { "value": "truck", "label": "Truck" },
        { "value": "cup", "label": "Cup" },
        { "value": "heart", "label": "Heart" },
        { "value": "hand", "label": "Hand + leaf" },
        { "value": "none", "label": "None" }
      ]
    },

    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Use an image without text on it." },
    {
      "type": "select", "id": "starter", "label": "Starter image (until you pick one)", "default": "1",
      "options": [
        { "value": "1", "label": "Picked" },
        { "value": "2", "label": "Sorted" },
        { "value": "3", "label": "Packed" },
        { "value": "4", "label": "Shipped" },
        { "value": "none", "label": "None (placeholder)" }
      ]
    },
    { "type": "text", "id": "sticker", "label": "Sticker on image", "info": "Optional short note, e.g. Pure natural goodness." },
    {
      "type": "select", "id": "ratio", "label": "Image shape", "default": "16 / 10",
      "options": [
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 3", "label": "4:3" },
        { "value": "16 / 10", "label": "16:10" },
        { "value": "16 / 9", "label": "Wide 16:9" }
      ]
    },
    {
      "type": "select", "id": "image_side", "label": "Image side on desktop", "default": "right",
      "options": [ { "value": "right", "label": "Right" }, { "value": "left", "label": "Left" } ]
    },
    { "type": "checkbox", "id": "float", "label": "Floating image", "default": true },

    { "type": "header", "content": "Style" },
    { "type": "color", "id": "tint", "label": "Number & accent colour", "default": "#1f7a35" },
    { "type": "color", "id": "c_bg", "label": "Background", "default": "#fbf8ef" },
    { "type": "checkbox", "id": "connector", "label": "Arrow from the previous step", "default": true },
    { "type": "text", "id": "anchor", "label": "Anchor id", "info": "Lets a button jump here, e.g. our-story → link #our-story." },
    { "type": "range", "id": "pt", "label": "Top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "pb", "label": "Bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 56 }
  ],
  "presets": [ { "name": "SF · Story step" } ]
}
{% endschema %}
