{%- comment -%}
  sf-cart-main: the dedicated cart page (/cart) in the DailyDip UI.
  Left: countdown + reward bar (same snippets and Theme settings as the drawer), then the line items.
  Right: sticky order summary with discount code, order note, checkout and trust bubbles.
  Updates over AJAX and re-renders this section, the drawer and the cart badge (assets/sf-cart-page.js).
  Styles: assets/sf-cart-page.css (+ sf-cart.css for the timer / reward bar).
{%- endcomment -%}
{%- liquid
  assign s = section.settings
-%}
{%- if s.load_fonts -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">
{%- endif -%}
{{ 'sf-cart-page.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sf-cart-page.js' | asset_url }}" defer></script>

<sf-cart-page
  class="sf-cp"
  data-section="{{ section.id }}"
  style="--sf-cp-pt: {{ s.pt }}px; --sf-cp-pb: {{ s.pb }}px; --sf-cp-bg: {{ s.c_bg }};"
>
  <div class="sf-cp__wrap">
    <div class="sf-cp__head">
      <nav class="sf-cp__crumbs" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">/</span><span aria-current="page">{{ s.heading | default: 'Your cart' }}</span>
      </nav>
      <div class="sf-cp__title-row">
        <h1 class="sf-cp__title">
          {{ s.heading | default: 'Your cart' }}
          {%- if cart.item_count > 0 -%}<span class="sf-cp__count">{{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %}</span>{%- endif -%}
        </h1>
        {%- if cart.item_count > 0 -%}
          <a class="sf-cp__continue" href="{{ s.continue_url | default: routes.all_products_collection_url }}">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
            {{ s.continue_label | default: 'Continue shopping' }}
          </a>
        {%- endif -%}
      </div>
    </div>

    {%- if cart.item_count == 0 -%}
      <div class="sf-cp__empty">
        <span class="sf-cp__empty-art" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="54" height="54" fill="none" stroke="#1c1c1c" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 8h14l-1.2 11.2a2 2 0 0 1-2 1.8H8.2a2 2 0 0 1-2-1.8L5 8z"/><path d="M9 10V7a3 3 0 0 1 6 0v3"/></svg>
        </span>
        <h2 class="sf-cp__empty-title">{{ s.empty_title }}</h2>
        {%- if s.empty_text != blank -%}<p class="sf-cp__empty-text">{{ s.empty_text }}</p>{%- endif -%}
        <a class="sf-cp__btn sf-cp__btn--yellow" href="{{ s.continue_url | default: routes.all_products_collection_url }}">{{ s.empty_button | default: 'Shop all blends' }}</a>
      </div>
    {%- else -%}
      <div class="sf-cp__grid">
        <div class="sf-cp__main">
          {%- if s.show_timer -%}{% render 'sf-cart-timer' %}{%- endif -%}
          {%- if s.show_rewards -%}{% render 'sf-cart-rewards' %}{%- endif -%}

          <div class="sf-cp__alert" role="alert" hidden data-cp-alert></div>

          <ul class="sf-cp__items" role="list" aria-label="Items in your cart">
            {%- for item in cart.items -%}
              {%- assign is_gift = false -%}
              {%- if item.properties['_sf_gift'] != blank -%}{%- assign is_gift = true -%}{%- endif -%}
              <li class="sf-cp__item{% if is_gift %} is-gift{% endif %}" data-key="{{ item.key }}">
                <a class="sf-cp__img" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
                  {%- if item.image -%}
                    {{ item.image | image_url: width: 360 | image_tag: loading: 'lazy', widths: '120, 180, 240, 360', sizes: '(min-width: 750px) 120px, 92px', alt: item.product.title }}
                  {%- endif -%}
                </a>
                <div class="sf-cp__info">
                  <h3 class="sf-cp__name"><a href="{{ item.url }}">{{ item.product.title }}</a></h3>
                  {%- if is_gift -%}<span class="sf-cp__gift">Free gift</span>{%- endif -%}
                  {%- unless item.product.has_only_default_variant -%}
                    <p class="sf-cp__variant">{{ item.variant.title }}</p>
                  {%- endunless -%}
                  <p class="sf-cp__unit">
                    {{ item.final_price | money }}
                    {%- if item.original_price > item.final_price -%}<s>{{ item.original_price | money }}</s>{%- endif -%}
                    <span>each</span>
                  </p>
                  {%- if item.line_level_discount_allocations.size > 0 -%}
                    <ul class="sf-cp__line-disc" role="list">
                      {%- for d in item.line_level_discount_allocations -%}
                        <li>{% render 'sf-icon', name: 'tag' %}{{ d.discount_application.title }} (−{{ d.amount | money }})</li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                  {%- unless item.product.has_only_default_variant or is_gift -%}
                    {%- if item.product.variants.size > 1 -%}
                      <div class="sf-cp__packs" role="radiogroup" aria-label="Change pack for {{ item.product.title | escape }}">
                        {%- for v in item.product.variants -%}
                          <button type="button" class="sf-cp__pack" role="radio"
                            data-cp-vpick="{{ v.id }}" data-key="{{ item.key }}" data-qty="{{ item.quantity }}"
                            aria-checked="{% if v.id == item.variant.id %}true{% else %}false{% endif %}"
                            {%- unless v.available %} disabled{% endunless %}>
                            <span class="sf-cp__pack-name">{{ v.title }}</span>
                            <span class="sf-cp__pack-price">{% if v.available %}{{ v.price | money_without_trailing_zeros }}{% else %}Sold out{% endif %}</span>
                          </button>
                        {%- endfor -%}
                      </div>
                    {%- endif -%}
                  {%- endunless -%}
                </div>
                <div class="sf-cp__right">
                  {%- unless is_gift -%}
                    <div class="sf-cp__qty" role="group" aria-label="Quantity for {{ item.product.title | escape }}">
                      <button type="button" data-cp-step="-1" data-key="{{ item.key }}" aria-label="Decrease quantity">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14"/></svg>
                      </button>
                      <input type="number" min="0" inputmode="numeric" value="{{ item.quantity }}" data-cp-qty data-key="{{ item.key }}" aria-label="Quantity">
                      <button type="button" data-cp-step="1" data-key="{{ item.key }}" aria-label="Increase quantity">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                      </button>
                    </div>
                  {%- endunless -%}
                  <p class="sf-cp__line">
                    {%- if item.original_line_price > item.final_line_price -%}<s>{{ item.original_line_price | money }}</s>{%- endif -%}
                    <span>{% if item.final_line_price == 0 %}Free{% else %}{{ item.final_line_price | money }}{% endif %}</span>
                  </p>
                  <button type="button" class="sf-cp__remove" data-cp-remove data-key="{{ item.key }}" aria-label="Remove {{ item.product.title | escape }}">
                    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-12M9 7V4h6v3"/></svg>
                    <span>Remove</span>
                  </button>
                </div>
              </li>
            {%- endfor -%}
          </ul>
        </div>

        <aside class="sf-cp__side{% if s.sticky %} is-sticky{% endif %}" aria-label="Order summary">
          <div class="sf-cp__card">
            <h2 class="sf-cp__card-title">{{ s.summary_title | default: 'Order summary' }}</h2>

            <dl class="sf-cp__sum">
              <div><dt>Subtotal</dt><dd>{{ cart.items_subtotal_price | money }}</dd></div>
              {%- for d in cart.cart_level_discount_applications -%}
                <div class="is-disc"><dt>{% render 'sf-icon', name: 'tag' %}{{ d.title }}</dt><dd>−{{ d.total_allocated_amount | money }}</dd></div>
              {%- endfor -%}
              {%- if s.shipping_note != blank -%}
                <div><dt>Shipping</dt><dd class="is-ship">{{ s.shipping_note }}</dd></div>
              {%- endif -%}
              <div class="is-total"><dt>Total</dt><dd>{{ cart.total_price | money }}</dd></div>
            </dl>
            {%- if cart.total_discount > 0 -%}
              <p class="sf-cp__saved">You're saving {{ cart.total_discount | money }}</p>
            {%- endif -%}

            {%- if s.show_discount -%}
              <div class="sf-cp__field">
                <label class="sf-cp__label" for="CpDisc-{{ section.id }}">Discount code</label>
                <div class="sf-cp__code">
                  <input id="CpDisc-{{ section.id }}" type="text" autocomplete="off" placeholder="Enter code" data-cp-code-input>
                  <button type="button" data-cp-code-apply>Apply</button>
                </div>
                <p class="sf-cp__code-msg" data-cp-code-msg role="status" hidden></p>
                {%- if cart.discount_codes.size > 0 -%}
                  <ul class="sf-cp__codes" role="list" data-cp-codes="{% for c in cart.discount_codes %}{{ c.code | escape }}{% unless forloop.last %},{% endunless %}{% endfor %}">
                    {%- for c in cart.discount_codes -%}
                      <li class="{% unless c.applicable %}is-off{% endunless %}">
                        {% render 'sf-icon', name: 'tag' %}<span>{{ c.code }}</span>
                        {%- unless c.applicable -%}<em>not applicable</em>{%- endunless -%}
                        <button type="button" data-cp-code-remove="{{ c.code | escape }}" aria-label="Remove code {{ c.code | escape }}">
                          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
                        </button>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </div>
            {%- endif -%}

            {%- if s.show_note -%}
              <details class="sf-cp__note"{% if cart.note != blank %} open{% endif %}>
                <summary>{% render 'sf-icon', name: 'chat' %}{{ s.note_label | default: 'Add a note to your order' }}</summary>
                <textarea rows="3" placeholder="{{ s.note_placeholder | default: 'Gift message, delivery instructions…' | escape }}" data-cp-note aria-label="Order note">{{ cart.note }}</textarea>
                <p class="sf-cp__note-msg" data-cp-note-msg role="status" hidden>Note saved</p>
              </details>
            {%- endif -%}

            <form action="{{ routes.cart_url }}" method="post" class="sf-cp__checkout-form">
              <button type="submit" name="checkout" class="sf-cp__checkout">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
                {{ s.checkout_label | default: 'Checkout' }}
              </button>
            </form>
            {%- if s.tax_note != blank -%}<p class="sf-cp__tax">{{ s.tax_note }}</p>{%- endif -%}

            {%- assign trust = section.blocks | where: 'type', 'trust' -%}
            {%- if trust.size > 0 -%}
              <ul class="sf-cp__trust" role="list" style="--n: {{ trust.size }}">
                {%- for b in trust -%}
                  <li {{ b.shopify_attributes }} style="--tint: {{ b.settings.tint }}; --i: {{ forloop.index0 }}">
                    <span class="sf-cp__bubble" aria-hidden="true">{% render 'sf-icon', name: b.settings.icon %}</span>
                    <span class="sf-cp__trust-text">{{ b.settings.text }}</span>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
            {%- if s.payment_icons -%}
              <div class="sf-cp__pay">
                {%- for type in shop.enabled_payment_types -%}{{ type | payment_type_svg_tag: class: 'sf-cp__pay-icon' }}{%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        </aside>
      </div>
    {%- endif -%}
  </div>
  <div class="sf-cp__busy" aria-hidden="true"></div>
</sf-cart-page>

{% schema %}
{
  "name": "SF · Cart page",
  "tag": "section",
  "class": "sf-cart-main-section",
  "settings": [
    { "type": "header", "content": "Headings" },
    { "type": "text", "id": "heading", "label": "Page heading", "default": "Your cart" },
    { "type": "text", "id": "continue_label", "label": "Continue shopping text", "default": "Continue shopping" },
    { "type": "url", "id": "continue_url", "label": "Continue shopping link", "info": "Empty = all products." },
    { "type": "header", "content": "Cart extras" },
    { "type": "checkbox", "id": "show_timer", "label": "Show countdown timer", "default": true, "info": "Uses Theme settings › SF Cart · Timer, same as the drawer." },
    { "type": "checkbox", "id": "show_rewards", "label": "Show reward bar", "default": true, "info": "Uses Theme settings › SF Cart · Rewards, same as the drawer." },
    { "type": "header", "content": "Order summary" },
    { "type": "text", "id": "summary_title", "label": "Summary heading", "default": "Order summary" },
    { "type": "text", "id": "shipping_note", "label": "Shipping line", "default": "Free", "info": "Leave empty to hide the line." },
    { "type": "checkbox", "id": "show_discount", "label": "Show discount code box", "default": true },
    { "type": "checkbox", "id": "show_note", "label": "Show order note", "default": true },
    { "type": "text", "id": "note_label", "label": "Order note title", "default": "Add a note to your order" },
    { "type": "text", "id": "note_placeholder", "label": "Order note placeholder", "default": "Gift message, delivery instructions…" },
    { "type": "text", "id": "checkout_label", "label": "Checkout button text", "default": "Checkout" },
    { "type": "text", "id": "tax_note", "label": "Note under checkout", "default": "Inclusive of all taxes." },
    { "type": "checkbox", "id": "payment_icons", "label": "Show payment icons", "default": false },
    { "type": "checkbox", "id": "sticky", "label": "Keep summary in view while scrolling (desktop)", "default": true },
    { "type": "header", "content": "Empty cart" },
    { "type": "text", "id": "empty_title", "label": "Title", "default": "Your cart is feeling a little empty" },
    { "type": "text", "id": "empty_text", "label": "Text", "default": "Pick a blend and start your daily dip." },
    { "type": "text", "id": "empty_button", "label": "Button text", "default": "Shop all blends" },
    { "type": "header", "content": "Style" },
    { "type": "checkbox", "id": "load_fonts", "label": "Load Fredoka + Poppins", "default": true },
    { "type": "color", "id": "c_bg", "label": "Background", "default": "#fbf8ef" },
    { "type": "range", "id": "pt", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 120, "info": "Leave room for the floating header." },
    { "type": "range", "id": "pb", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "trust",
      "name": "Trust bubble",
      "limit": 4,
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon", "default": "lock",
          "options": [
            { "value": "lock", "label": "Lock" }, { "value": "truck", "label": "Truck" }, { "value": "return", "label": "Return" },
            { "value": "shield", "label": "Shield" }, { "value": "leaf", "label": "Leaf" }, { "value": "hand-leaf", "label": "Hand + leaf" },
            { "value": "gift", "label": "Gift" }, { "value": "award", "label": "Award" }, { "value": "heart", "label": "Heart" },
            { "value": "chat", "label": "Chat" }, { "value": "clock", "label": "Clock" }, { "value": "cup-steam", "label": "Tea cup" }
          ]
        },
        { "type": "text", "id": "text", "label": "Text", "default": "Secure checkout" },
        { "type": "color", "id": "tint", "label": "Bubble colour", "default": "#c8f169" }
      ]
    }
  ],
  "presets": [
    {
      "name": "SF · Cart page",
      "blocks": [
        { "type": "trust", "settings": { "icon": "lock", "text": "Secure checkout", "tint": "#c8f169" } },
        { "type": "trust", "settings": { "icon": "truck", "text": "Free shipping", "tint": "#ffd23f" } },
        { "type": "trust", "settings": { "icon": "hand-leaf", "text": "Natural herbs", "tint": "#e9f7d0" } }
      ]
    }
  ]
}
{% endschema %}
