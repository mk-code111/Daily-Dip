{%- comment -%}
  sf-password — DailyDip "something's brewing" launch page.
  Logo, sticker, big title, a steeping cup with rising steam, optional launch
  countdown, notify-me signup (customer tag "prelaunch"), socials, and a small
  "Store owner? Enter password" panel.
  Styles: assets/sf-pages.css · Script: assets/sf-pages.js
{%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">
{{ 'sf-pdp.css' | asset_url | stylesheet_tag }}
{{ 'sf-pages.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sf-pages.js' | asset_url }}" defer></script>

{%- liquid
  assign s = section.settings
  assign socials = 'instagram,facebook,youtube,linkedin,x,whatsapp' | split: ','
  assign pw_error = false
-%}
<style>
  #shopify-section-{{ section.id }} {
    --sf-pw-bg: {{ s.c_bg }};
    --sf-pw-card: {{ s.c_card }};
    --sf-pw-accent: {{ s.c_accent }};
  }
</style>

<section class="sf-pdp sf-pw">
  <div class="sf-pw__leaves" aria-hidden="true">
    {%- for i in (1..5) -%}<svg class="sf-pw__leaf sf-pw__leaf--{{ i }}" viewBox="0 0 24 24"><path d="M5 19c0-8 5-13 14-14-1 9-6 14-14 14z"/><path d="M5 19l7-7" fill="none"/></svg>{%- endfor -%}
  </div>

  <div class="sf-pw__card">
    <div class="sf-pw__top">
      {%- if s.logo != blank -%}
        {%- assign logo_style = 'width: ' | append: s.logo_width | append: 'px' -%}
        {{ s.logo | image_url: width: 520 | image_tag: alt: shop.name, class: 'sf-pw__logo', style: logo_style }}
      {%- else -%}
        <span class="sf-pw__logo-text">{{ shop.name | escape }}</span>
      {%- endif -%}
    </div>

    <div class="sf-pw__cup" aria-hidden="true">
      <svg viewBox="0 0 200 170">
        <g class="sf-pw__steam"><path d="M74 52c-7-9 7-15 0-27"/><path d="M100 46c-7-9 7-15 0-27"/><path d="M126 52c-7-9 7-15 0-27"/></g>
        <path class="sf-pw__body" d="M40 62h120v40a50 50 0 0 1-50 50h-20a50 50 0 0 1-50-50z"/>
        <path class="sf-pw__tea" d="M48 72h104v28a42 42 0 0 1-42 42h-20a42 42 0 0 1-42-42z"/>
        <path class="sf-pw__handle" d="M160 76h10a20 20 0 0 1 0 40h-12"/>
        <path class="sf-pw__string" d="M106 62c4 14 14 18 22 32"/>
        <rect class="sf-pw__tag" x="116" y="92" width="28" height="22" rx="4"/>
        <ellipse class="sf-pw__saucer" cx="100" cy="158" rx="78" ry="9"/>
      </svg>
    </div>

    {%- if s.sticker != blank -%}<p class="sf-pw__sticker">{{ s.sticker | escape }}</p>{%- endif -%}
    <h1 class="sf-pw__title">{{ s.title }}</h1>
    {%- if shop.password_message != blank -%}
      <div class="sf-pw__text">{{ shop.password_message }}</div>
    {%- elsif s.text != blank -%}
      <div class="sf-pw__text">{{ s.text }}</div>
    {%- endif -%}

    {%- if s.launch_date != blank -%}
      <div class="sf-pw__count" data-sf-pw-count="{{ s.launch_date | escape }}" hidden>
        <div><b data-u="d">00</b><span>{{ s.l_days | escape }}</span></div>
        <div><b data-u="h">00</b><span>{{ s.l_hours | escape }}</span></div>
        <div><b data-u="m">00</b><span>{{ s.l_mins | escape }}</span></div>
        <div><b data-u="s">00</b><span>{{ s.l_secs | escape }}</span></div>
      </div>
    {%- endif -%}

    {%- if s.show_notify -%}
      {%- form 'customer', id: 'SfPwNotify', class: 'sf-pw__notify' -%}
        <input type="hidden" name="contact[tags]" value="prelaunch,newsletter">
        {%- if form.posted_successfully? -%}
          <p class="sf-pw__ok" role="status"><span>{% render 'sf-icon', name: 'check' %}</span>{{ s.notify_success | escape }}</p>
        {%- else -%}
          <div class="sf-pw__field">
            <label class="visually-hidden" for="SfPwEmail">{{ s.notify_placeholder | escape }}</label>
            <input id="SfPwEmail" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ s.notify_placeholder | escape }}">
            <button type="submit" class="sf-pw__btn">{{ s.notify_button | escape }}</button>
          </div>
          {%- if form.errors -%}<p class="sf-pw__err">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
        {%- endif -%}
      {%- endform -%}
    {%- endif -%}

    {%- liquid
      assign has_social = false
      for n in socials
        assign key = 'social_' | append: n
        if s[key] != blank
          assign has_social = true
        endif
      endfor
    -%}
    {%- if has_social -%}
      <ul class="sf-pw__social" role="list">
        {%- for n in socials -%}
          {%- assign key = 'social_' | append: n -%}
          {%- if s[key] != blank -%}
            <li><a href="{{ s[key] }}" target="_blank" rel="noopener" aria-label="{{ n | capitalize }}">{% render 'sf-social-icon', name: n %}</a></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>

  {%- comment -%} owner login {%- endcomment -%}
  {%- form 'storefront_password', class: 'sf-pw__owner-form' -%}
    {%- if form.errors -%}{%- assign pw_error = true -%}{%- endif -%}
    <details class="sf-pw__owner"{% if pw_error %} open{% endif %}>
      <summary>{% render 'sf-icon', name: 'lock' %}<span>{{ s.owner_label | escape }}</span></summary>
      <div class="sf-pw__owner-body">
        <div class="sf-pw__field">
          <label class="visually-hidden" for="SfPwPass">{{ 'general.password_page.input_label' | t }}</label>
          <input id="SfPwPass" type="password" name="password" autocomplete="current-password" placeholder="{{ s.password_placeholder | escape }}"{% if pw_error %} aria-invalid="true" aria-describedby="SfPwPassErr"{% endif %}>
          <button type="submit" class="sf-pw__btn sf-pw__btn--dark">{{ s.password_button | escape }}</button>
        </div>
        {%- if pw_error -%}<p class="sf-pw__err" id="SfPwPassErr">{{ s.password_error | escape }}</p>{%- endif -%}
        <p class="sf-pw__admin">{{ s.admin_text | escape }} <a href="/admin" target="_blank" rel="noopener">{{ s.admin_link | escape }}</a></p>
      </div>
    </details>
  {%- endform -%}

  <p class="sf-pw__foot">&copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</p>
</section>

{% schema %}
{
  "name": "SF · Password",
  "tag": "div",
  "class": "sf-pw-section",
  "enabled_on": { "templates": ["password"] },
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "range", "id": "logo_width", "label": "Logo width", "min": 80, "max": 260, "step": 10, "unit": "px", "default": 150 },
    { "type": "text", "id": "sticker", "label": "Sticker", "default": "Something's brewing" },
    { "type": "inline_richtext", "id": "title", "label": "Title", "default": "Our new blends are <em>steeping</em>" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>We're getting everything ready. Leave your email and you'll be the first to sip.</p>", "info": "The password message from Online Store → Preferences replaces this when it's set." },

    { "type": "header", "content": "Countdown" },
    { "type": "text", "id": "launch_date", "label": "Launch date & time", "placeholder": "2026-12-01 10:00", "info": "Format YYYY-MM-DD HH:MM (your local time). Leave empty to hide the countdown." },
    { "type": "text", "id": "l_days", "label": "Days label", "default": "days" },
    { "type": "text", "id": "l_hours", "label": "Hours label", "default": "hrs" },
    { "type": "text", "id": "l_mins", "label": "Minutes label", "default": "min" },
    { "type": "text", "id": "l_secs", "label": "Seconds label", "default": "sec" },

    { "type": "header", "content": "Notify me" },
    { "type": "checkbox", "id": "show_notify", "label": "Email signup", "default": true },
    { "type": "text", "id": "notify_placeholder", "label": "Placeholder", "default": "Your email address" },
    { "type": "text", "id": "notify_button", "label": "Button", "default": "Notify me" },
    { "type": "text", "id": "notify_success", "label": "Thank-you message", "default": "You're on the list! We'll ping you at launch." },

    { "type": "header", "content": "Owner login" },
    { "type": "text", "id": "owner_label", "label": "Toggle text", "default": "Store owner? Enter password" },
    { "type": "text", "id": "password_placeholder", "label": "Password placeholder", "default": "Store password" },
    { "type": "text", "id": "password_button", "label": "Button", "default": "Enter" },
    { "type": "text", "id": "password_error", "label": "Wrong password message", "default": "That password didn't steep right. Try again." },
    { "type": "text", "id": "admin_text", "label": "Admin text", "default": "Are you the owner?" },
    { "type": "text", "id": "admin_link", "label": "Admin link text", "default": "Log in here" },

    { "type": "header", "content": "Social links" },
    { "type": "url", "id": "social_instagram", "label": "Instagram" },
    { "type": "url", "id": "social_facebook", "label": "Facebook" },
    { "type": "url", "id": "social_youtube", "label": "YouTube" },
    { "type": "url", "id": "social_linkedin", "label": "LinkedIn" },
    { "type": "url", "id": "social_x", "label": "X (Twitter)" },
    { "type": "url", "id": "social_whatsapp", "label": "WhatsApp" },

    { "type": "header", "content": "Style" },
    { "type": "color", "id": "c_bg", "label": "Background", "default": "#1f7a35" },
    { "type": "color", "id": "c_card", "label": "Card", "default": "#fbf8ef" },
    { "type": "color", "id": "c_accent", "label": "Accent", "default": "#c8f169" }
  ],
  "presets": [{ "name": "SF · Password" }]
}
{% endschema %}
