{%- comment -%}
  sf-pdp-related — Shopify product recommendations in the SF card style.
  Loads lazily via the Section Rendering API (recommendations object).
  Single-variant products get a quick "Add" button; others link to the product.
{%- endcomment -%}
{{ 'sf-pdp.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sf-pdp.js' | asset_url }}" defer></script>

<style>
  #shopify-section-{{ section.id }} .sf-pdp-related {
    padding-top: {{ section.settings.pt }}px;
    padding-bottom: {{ section.settings.pb }}px;
  }
</style>

<sf-pdp-related
  class="sf-pdp sf-pdp-related"
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent={{ section.settings.intent }}"
>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="sf-pdp__wrap">
      <div class="sf-sec">
        {%- if section.settings.heading != blank -%}
          <h2 class="sf-h2">{{ section.settings.heading }}</h2>
        {%- endif -%}
        <div class="sf-rel__track" style="--sf-rel-cols: {{ section.settings.limit | at_most: 4 }};">
          {%- for p in recommendations.products -%}
            {%- assign pv = p.selected_or_first_available_variant -%}
            <div class="sf-box sf-card">
              <a class="sf-card__img" href="{{ p.url }}" tabindex="-1" aria-hidden="true">
                {%- if p.featured_image -%}
                  {{ p.featured_image | image_url: width: 600 | image_tag: widths: '300, 450, 600', sizes: '(min-width: 1100px) 270px, (min-width: 768px) 30vw, 46vw', loading: 'lazy', alt: p.featured_image.alt | default: p.title }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag }}
                {%- endif -%}
              </a>
              <a class="sf-card__title" href="{{ p.url }}">{{ p.title }}</a>
              <div class="sf-card__price">
                <b>{{ p.price | money_without_trailing_zeros }}</b>
                {%- if p.compare_at_price > p.price -%}<s>{{ p.compare_at_price | money_without_trailing_zeros }}</s>{%- endif -%}
              </div>
              {%- if p.has_only_default_variant and p.available -%}
                <button type="button" class="sf-btn" data-sf-quick-add="{{ pv.id }}" data-label="{{ section.settings.add_label | escape }}">{{ section.settings.add_label }}</button>
              {%- elsif p.available -%}
                <a class="sf-btn" href="{{ p.url }}">{{ section.settings.options_label }}</a>
              {%- else -%}
                <button type="button" class="sf-btn" disabled>{{ section.settings.soldout_label }}</button>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}
</sf-pdp-related>

{% schema %}
{
  "name": "SF · Related products",
  "tag": "section",
  "class": "sf-pdp-related-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
    {
      "type": "select", "id": "intent", "label": "Type", "default": "related",
      "options": [
        { "value": "related", "label": "Related" },
        { "value": "complementary", "label": "Complementary (set in Search & Discovery app)" }
      ]
    },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "text", "id": "add_label", "label": "Add button", "default": "Add" },
    { "type": "text", "id": "options_label", "label": "Options button", "default": "Choose pack" },
    { "type": "text", "id": "soldout_label", "label": "Sold out button", "default": "Sold out" },
    { "type": "range", "id": "pt", "label": "Top padding", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 16 },
    { "type": "range", "id": "pb", "label": "Bottom padding", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 48 }
  ],
  "enabled_on": { "templates": ["product"] },
  "presets": [{ "name": "SF · Related products" }]
}
{% endschema %}
