<div
  id="simple-collections-{{ section.id }}" 
  class="
    simple-collections viewport-detect
    {{ section.settings.bg_color }}
    {{ section.settings.text_color }}
    {{ section.settings.border_top_width | prepend: 'border-top-' }}
    {{ section.settings.border_bottom_width | prepend: 'border-bottom-' }}
    {{ section.settings.border_color }}  
    {{ section.settings.pt_mobile | prepend: 'pt-' }} 
    {{ section.settings.pb_mobile | prepend: 'pb-' }}
    {{ section.settings.pt_desktop | prepend: 'pt-desktop-' }} 
    {{ section.settings.pb_desktop | prepend: 'pb-desktop-' }}
  "
  style=" 
    --bs-bg-opacity: {{ section.settings.bg_opacity | append: '%' }};
    --bs-border-opacity: {{ section.settings.border_opacity | append: '%' }};
    background-image: linear-gradient({{ section.settings.bg_gradient_direction | append: 'deg' }}, rgba(var(--text-color-rgb), {{ section.settings.bg_gradient_opacity | append: '%'}}), rgba(var(--text-color-rgb), 0));
  ">
  <div 
    class="container"
    style="max-width: {{ section.settings.container_max_width | append: 'px' }};">
    {% render 'section-header' %}
    <simple-collections 
      class="
        simple-collections-list d-flex justify-content-desktop-center flex-desktop-wrap mx-n3
        {{ section.settings.item_text_align }}
      " 
      style="--item-animation-name: {{ section.settings.item_animation }}"
      data-has-animation="{% if section.settings.item_animation != blank %}true{% else %}false{% endif %}"
      role="list" 
      aria-label="{{ section.settings.label }}">
      {% for block in section.blocks %} 
        {% liquid
          assign img = block.settings.img | default: block.settings.collection.image
          assign title = block.settings.title | default: block.settings.collection.title
 
          if forloop.index <= 6
            assign img_placeholdeer = 'collection-' | append: forloop.index
          else
            assign img_placeholdeer = 'collection-1'
          endif
        %}
        <div 
          class="
            simple-collections-item p-3
            {% if block.settings.collection.id and block.settings.collection.handle == collection.handle %}active{% endif %}
          "
          style="animation-delay: {{ forloop.index | times: 100 | append: 'ms' }}"
          role="listitem" 
          {{ block.shopify_attributes }}>
          <a href="{{ block.settings.collection.url }}" >
            <div 
              class="img-wrapper mb-4 {% if section.settings.item_img_circle %}img-wrapper-circle{% endif %}">
              {% if img %}
                {% render 'image-url', img: img, size: section.settings.item_img_size, ratio: section.settings.item_img_ratio, class: section.settings.item_img_border, scale: true %}
              {% else %}
                {{ img_placeholdeer | placeholder_svg_tag: 'svg-placeholder img-thumbnail rounded-circle' }}
              {% endif %}
            </div>
            {% if section.settings.item_show_title %}
              <h3 class="collection-title mb-0 {{ section.settings.item_title_font_size }} {% if section.settings.item_title_truncate %}text-truncate{% endif %}">
                {% if title %}
                  {{ title | default: 'Collection title' }} 
                  {% if section.settings.item_show_product_count %}
                    ({{ block.settings.collection.products_count }})
                  {% endif %}
                {% else %}
                  Collection {{ forloop.index }}
                {% endif %}
              </h3>
            {% endif %}
          </a>
        </div>
      {% endfor %}
    </simple-collections>
  </div>
</div>

{% if request.design_mode %}
  <script>
    document.addEventListener('shopify:section:load', (event) => {
      event.target.querySelector('.viewport-detect')?.classList.add('viewport-entered')
    })
  </script>
{% endif %}

{% schema %}
{
  "name": "Simple collections",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Styling"
    },
    {
      "type": "select",
      "id": "bg_color",
      "label": "Background color",
      "default": "bg-body",
      "options": [
        { "value": "bg-primary", "label": "Primary" },
        { "value": "bg-secondary", "label": "Secondary" },
        { "value": "bg-body", "label": "Body" },
        { "value": "bg-white", "label": "White" }
      ]
    },
    {
      "type": "range",
      "id": "bg_opacity",
      "label": "Background opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 100,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "bg_gradient_opacity",
      "label": "Background gradient opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 0,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "bg_gradient_direction",
      "label": "Background gradient direction",
      "min": 0,
      "max": 360,
      "step": 15,
      "default": 180,
      "unit": "deg"
    },
    {
      "type": "select",
      "id": "text_color",
      "label": "Text color",
      "default": "text-body",
      "options": [
        { "value": "text-primary", "label": "Primary" },
        { "value": "text-secondary", "label": "Secondary" },
        { "value": "text-body", "label": "Body" },
        { "value": "text-white", "label": "White" }
      ]
    },
    {
      "type": "range",
      "id": "border_top_width",
      "label": "Border top width",
      "default": 0,
      "min": 0,
      "max": 16,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "border_bottom_width",
      "label": "Border bottom width",
      "default": 0,
      "min": 0,
      "max": 16,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "border_color",
      "label": "Border color",
      "default": "border-body",
      "options": [
        { "value": "border-primary", "label": "Primary" },
        { "value": "border-secondary", "label": "Secondary" },
        { "value": "border-body", "label": "Body" },
        { "value": "border-white", "label": "White" }
      ]
    },
    {
      "type": "range",
      "id": "border_opacity",
      "label": "Border opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 100,
      "unit": "%"
    }, 
    {
      "type": "text",
      "id": "container_max_width",
      "label": "Container max-width (px)",
      "info": "Leave empty to use the global container width"
    },
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "inline_richtext",
      "id": "header_title",
      "label": "Title"
    },
    {
      "type": "select",
      "id": "header_title_font_size",
      "label": "Title font-size",
      "default": "h2",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ]
    },
    {
      "type": "richtext",
      "id": "header_description",
      "label": "Description (optional)"
    },
    {
      "type": "select",
      "id": "header_description_font_size",
      "label": "Description font-size",
      "default": "fs-md",
      "options": [
        { "value": "fs-sm", "label": "sm" },
        { "value": "fs-md", "label": "md" },
        { "value": "fs-lg", "label": "lg" },
        { "value": "fs-xl", "label": "xl" },
        { "value": "fs-xxl", "label": "xxl" }
      ]
    },
    {
      "type": "text",
      "id": "label",
      "label": "List label",
      "info": "Needed for accessibility purposes",
      "default": "Featured collections"
    },
    {
      "type": "header",
      "content": "Collection item"
    },
    {
      "type": "select",
      "id": "item_animation",
      "label": "Animation",
      "info": "NOTE: You must click the \"Save\" button to preview changes",
      "default": "fadeInRight",
      "options": [
        { "value": "", "label": "None" },
        { "value": "fadeIn", "label": "FadeIn" },
        { "value": "fadeInUp", "label": "FadeInUp" },
        { "value": "fadeInDown", "label": "FadeInDown" },
        { "value": "fadeInLeft", "label": "FadeInLeft" },
        { "value": "fadeInRight", "label": "FadeInRight" },
        { "value": "zoomIn", "label": "ZoomIn" }
      ]
    },
    {
      "type": "select",
      "id": "item_text_align",
      "label": "Text align",
      "default": "text-center",
      "options": [
        { "value": "text-start", "label": "Left" },
        { "value": "text-center", "label": "Center" },
        { "value": "text-end", "label": "Right" }
      ]
    },
    {
      "type": "range",
      "id": "item_img_size",
      "label": "Image size",
      "default": 120,
      "min": 50,
      "max": 300,
      "step": 5,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "item_img_ratio",
      "label": "Image ratio",
      "default": "ratio-1x1",
      "options": [
        { "group": "Adapt", "value": "adapt", "label": "Adapt" },
        { "group": "Square", "value": "ratio-1x1", "label": "1x1" },
        { "group": "Horizontal", "value": "ratio-4x3", "label": "4x3" },
        { "group": "Horizontal", "value": "ratio-16x9", "label": "16x9" },
        { "group": "Horizontal", "value": "ratio-21x9", "label": "21x9" },
        { "group": "Vertical", "value": "ratio-3x4", "label": "3x4" },
        { "group": "Vertical", "value": "ratio-9x16", "label": "9x16" },
        { "group": "Vertical", "value": "ratio-9x21", "label": "9x21" }
      ]
    },
    {
      "type": "select",
      "id": "item_img_border",
      "label": "Image border",
      "default": "img-thumbnail",
      "options": [
        { "value": "", "label": "None" },
        { "value": "rounded",  "label": "Rounded" },
        { "value": "img-thumbnail", "label": "Thumbnail" }
      ]
    },
    {
      "type": "checkbox",
      "id": "item_img_circle",
      "label": "Circle images",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "item_show_title",
      "label": "Show title",
      "default": true
    },
    {
      "type": "select",
      "id": "item_title_font_size",
      "label": "Title font-size",
      "default": "fs-xs",
      "options": [
        { "value": "fs-xxs", "label": "xxs" },
        { "value": "fs-xs", "label": "xs" },
        { "value": "fs-sm", "label": "sm" },
        { "value": "fs-md", "label": "md" },
        { "value": "fs-lg", "label": "lg" }
      ]
    },
    {
      "type": "checkbox",
      "id": "item_title_truncate",
      "label": "Title truncate",
      "info": "Prevent titles from breaking into multiple lines",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "item_show_product_count",
      "label": "Show product count",
      "default": true
    },
    {
      "type": "header",
      "content": "Spacing - Mobile"
    },
    {
      "type": "range",
      "id": "pt_mobile",
      "label": "Top",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "pb_mobile",
      "label": "Bottom",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 8
    },
    {
      "type": "header",
      "content": "Spacing - Desktop"
    },
    {
      "type": "range",
      "id": "pt_desktop",
      "label": "Top",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 10
    },
    {
      "type": "range",
      "id": "pb_desktop",
      "label": "Bottom",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 10
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
       },
       {
          "type": "image_picker",
          "id": "img",
          "label": "Image",
          "info": "Optional - Leave empty to use the default collection image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "info": "Optional - Leave empty to use the default collection title"
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "presets": [
    {
      "name": "Simple collections",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}