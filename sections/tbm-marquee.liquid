{%- comment -%}
  tbm-marquee — DailyDip "tea ribbon" marquee.
  A tilted ink-bordered band scrolling text and image items, with spinning tea
  separators. Optional second ribbon crossing it in the opposite direction.
  Styles: assets/tbm-marquee.css · Script: assets/tbm-marquee.js
{%- endcomment -%}
{{ 'tbm-marquee.css' | asset_url | stylesheet_tag }}
<script src="{{ 'tbm-marquee.js' | asset_url }}" defer></script>

{%- liquid
  assign s = section.settings
  assign tilt2 = s.tilt | times: -1
  if s.second_text != blank
    assign second_items = s.second_text | split: ','
  endif
-%}
<style>
  #shopify-section-{{ section.id }} {
    --tbm-mq-bg: {{ s.c_bg }};
    --tbm-mq-band: {{ s.c_band }};
    --tbm-mq-text: {{ s.c_text }};
    --tbm-mq-band2: {{ s.c_band2 }};
    --tbm-mq-text2: {{ s.c_text2 }};
    --tbm-mq-sep: {{ s.c_sep }};
    --tbm-mq-tilt: {{ s.tilt }}deg;
    --tbm-mq-tilt2: {{ tilt2 }}deg;
    --tbm-mq-size: {{ s.size_mobile }}px;
    --tbm-mq-img: {{ s.img_height | times: 0.7 | round }}px;
    --tbm-mq-gap: {{ s.gap | times: 0.7 | round }}px;
    --tbm-mq-pt: {{ s.pt | times: 0.7 | round }}px;
    --tbm-mq-pb: {{ s.pb | times: 0.7 | round }}px;
  }
  @media (min-width: 990px) {
    #shopify-section-{{ section.id }} {
      --tbm-mq-size: {{ s.size_desktop }}px;
      --tbm-mq-img: {{ s.img_height }}px;
      --tbm-mq-gap: {{ s.gap }}px;
      --tbm-mq-pt: {{ s.pt }}px;
      --tbm-mq-pb: {{ s.pb }}px;
    }
  }
</style>

{%- capture sep -%}
  {%- if s.separator != 'none' -%}
    <span class="tbm-mq__sep{% if s.spin %} is-spin{% endif %}" aria-hidden="true">
      {%- if s.separator == 'image' and s.separator_img != blank -%}
        {{ s.separator_img | image_url: width: 120 | image_tag: alt: '', loading: 'lazy' }}
      {%- else -%}
        {%- case s.separator -%}
          {%- when 'leaf' -%}<svg viewBox="0 0 24 24"><path d="M5 19c0-8 5-13 14-14-1 9-6 14-14 14z" fill="currentColor"/><path d="M5 19l7-7" fill="none" stroke="var(--tbm-mq-sep)" stroke-width="1.6" stroke-linecap="round"/></svg>
          {%- when 'cup' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9h13v4a6 6 0 0 1-6 6H10a6 6 0 0 1-6-6z" fill="currentColor"/><path d="M17 10h1.5a2.5 2.5 0 0 1 0 5H17"/><path d="M8 3c-1 1.3 1 2 0 3.5M12 3c-1 1.3 1 2 0 3.5"/></svg>
          {%- when 'sparkle' -%}<svg viewBox="0 0 24 24"><path d="M12 2l2.4 7.6L22 12l-7.6 2.4L12 22l-2.4-7.6L2 12l7.6-2.4z" fill="currentColor"/></svg>
          {%- when 'star' -%}<svg viewBox="0 0 24 24"><path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z" fill="currentColor"/></svg>
          {%- when 'heart' -%}<svg viewBox="0 0 24 24"><path d="M12 20s-7.5-4.6-7.5-10A4.2 4.2 0 0 1 12 7.5 4.2 4.2 0 0 1 19.5 10c0 5.4-7.5 10-7.5 10z" fill="currentColor"/></svg>
          {%- when 'drop' -%}<svg viewBox="0 0 24 24"><path d="M12 3s6.5 7 6.5 11.2A6.5 6.5 0 0 1 5.5 14.2C5.5 10 12 3 12 3z" fill="currentColor"/></svg>
        {%- endcase -%}
      {%- endif -%}
    </span>
  {%- endif -%}
{%- endcapture -%}

{%- capture items -%}
  {%- for block in section.blocks -%}
    {%- assign b = block.settings -%}
    {%- if block.type == 'image' and b.img != blank -%}
      {%- if b.url != blank -%}<a class="tbm-mq__item tbm-mq__item--img" href="{{ b.url }}">{%- else -%}<span class="tbm-mq__item tbm-mq__item--img">{%- endif -%}
        {{ b.img | image_url: height: 240 | image_tag: alt: b.img.alt, loading: 'lazy' }}
      {%- if b.url != blank -%}</a>{%- else -%}</span>{%- endif -%}
      {{ sep }}
    {%- elsif block.type == 'text' and b.text != blank -%}
      {%- if b.url != blank -%}<a class="tbm-mq__item tbm-mq__item--{{ b.style | default: 'fill' }}" href="{{ b.url }}">{%- else -%}<span class="tbm-mq__item tbm-mq__item--{{ b.style | default: 'fill' }}">{%- endif -%}
        {{ b.text | escape }}
      {%- if b.url != blank -%}</a>{%- else -%}</span>{%- endif -%}
      {{ sep }}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

<section
  class="tbm-pdp tbm-mq tbm-mq--{{ s.layout }}{% if s.uppercase %} tbm-mq--upper{% endif %}{% if s.pause_hover %} tbm-mq--pause{% endif %}"
  aria-label="{{ s.list_label | escape }}"
>
  {%- if s.header_title != blank -%}<h2 class="tbm-mq__title">{{ s.header_title }}</h2>{%- endif -%}

  <div class="tbm-mq__stage">
    {%- if s.layout == 'crossed' -%}
      <div class="tbm-mq__band tbm-mq__band--2" data-tbm-mq data-dir="{% if s.direction == 'left' %}right{% else %}left{% endif %}" data-speed="{{ s.speed | times: 1.2 }}" aria-hidden="true">
        <div class="tbm-mq__track">
          <div class="tbm-mq__group">
            {%- if second_items -%}
              {%- for t in second_items -%}
                {%- assign tt = t | strip -%}
                {%- if tt != blank -%}<span class="tbm-mq__item tbm-mq__item--fill">{{ tt | escape }}</span>{{ sep }}{%- endif -%}
              {%- endfor -%}
            {%- else -%}
              {{ items }}
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endif -%}

    <div class="tbm-mq__band tbm-mq__band--1" data-tbm-mq data-dir="{{ s.direction }}" data-speed="{{ s.speed }}">
      <div class="tbm-mq__track">
        <div class="tbm-mq__group">{{ items }}</div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "TBM · Marquee",
  "tag": "div",
  "class": "tbm-mq-section",
  "max_blocks": 16,
  "settings": [
    { "type": "header", "content": "Ribbon" },
    {
      "type": "select", "id": "layout", "label": "Style", "default": "crossed",
      "options": [
        { "value": "ribbon", "label": "Tilted ribbon" },
        { "value": "crossed", "label": "Crossed ribbons" },
        { "value": "flat", "label": "Flat strip" }
      ]
    },
    { "type": "range", "id": "tilt", "label": "Tilt", "min": -6, "max": 6, "step": 1, "unit": "°", "default": -2, "info": "Not used by the flat strip." },
    { "type": "text", "id": "second_text", "label": "Second ribbon text", "default": "Steeped with love,Sip slow,Feel good daily", "info": "Crossed ribbons only. Comma-separated. Leave empty to repeat the main items." },
    { "type": "inline_richtext", "id": "header_title", "label": "Heading above" },
    { "type": "text", "id": "list_label", "label": "Label (screen readers)", "default": "Promotional list" },

    { "type": "header", "content": "Motion" },
    { "type": "range", "id": "speed", "label": "Speed", "min": 20, "max": 160, "step": 10, "unit": "px", "default": 70, "info": "Pixels per second." },
    { "type": "select", "id": "direction", "label": "Direction", "default": "left", "options": [{ "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }] },
    { "type": "checkbox", "id": "pause_hover", "label": "Pause on hover", "default": true },

    { "type": "header", "content": "Text & separators" },
    { "type": "range", "id": "size_mobile", "label": "Text size: phone", "min": 16, "max": 40, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "size_desktop", "label": "Text size: desktop", "min": 20, "max": 72, "step": 2, "unit": "px", "default": 40 },
    { "type": "checkbox", "id": "uppercase", "label": "Uppercase", "default": false },
    { "type": "range", "id": "gap", "label": "Spacing", "min": 8, "max": 60, "step": 2, "unit": "px", "default": 26 },
    {
      "type": "select", "id": "separator", "label": "Separator", "default": "leaf",
      "options": [
        { "value": "leaf", "label": "Tea leaf" },
        { "value": "cup", "label": "Tea cup" },
        { "value": "sparkle", "label": "Sparkle" },
        { "value": "star", "label": "Star" },
        { "value": "heart", "label": "Heart" },
        { "value": "drop", "label": "Drop" },
        { "value": "image", "label": "Custom image" },
        { "value": "none", "label": "None" }
      ]
    },
    { "type": "image_picker", "id": "separator_img", "label": "Custom separator image" },
    { "type": "checkbox", "id": "spin", "label": "Spin separators", "default": true },
    { "type": "range", "id": "img_height", "label": "Image height", "min": 30, "max": 120, "step": 2, "unit": "px", "default": 60 },

    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "c_bg", "label": "Section background", "default": "#ffffff" },
    { "type": "color", "id": "c_band", "label": "Ribbon", "default": "#1f7a35" },
    { "type": "color", "id": "c_text", "label": "Ribbon text", "default": "#ffffff" },
    { "type": "color", "id": "c_sep", "label": "Separator", "default": "#c8f169" },
    { "type": "color", "id": "c_band2", "label": "Second ribbon", "default": "#c8f169" },
    { "type": "color", "id": "c_text2", "label": "Second ribbon text", "default": "#1c1c1c" },

    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "pt", "label": "Top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "pb", "label": "Bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Sip. Steep. Smile." },
        {
          "type": "select", "id": "style", "label": "Style", "default": "fill",
          "options": [
            { "value": "fill", "label": "Filled" },
            { "value": "outline", "label": "Outlined" },
            { "value": "sticker", "label": "Lime sticker" }
          ]
        },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "img", "label": "Image" },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "TBM · Marquee",
      "blocks": [
        { "type": "text", "settings": { "text": "Sip. Steep. Smile.", "style": "fill" } },
        { "type": "text", "settings": { "text": "100% natural", "style": "outline" } },
        { "type": "text", "settings": { "text": "Feel-good blends", "style": "sticker" } }
      ]
    }
  ]
}
{% endschema %}
