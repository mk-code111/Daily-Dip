{{ 'tbm-pdp.css' | asset_url | stylesheet_tag }}

<style>
  #shopify-section-{{ section.id }} .tbm-pdp-know-more {
    padding-top: {{ section.settings.pt }}px;
    padding-bottom: {{ section.settings.pb }}px;
  }
</style>

<div class="tbm-pdp tbm-pdp-know-more">
  <div class="tbm-pdp__wrap">
   <div class="tbm-km tbm-reveal">
    <div>
      {%- if section.settings.heading != blank -%}
        <h2 class="tbm-h2">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <div class="tbm-km__intro">{{ section.settings.intro }}</div>
      {%- endif -%}
    </div>
    {%- if section.blocks.size > 0 -%}
      <div class="tbm-box tbm-acc">
        {%- for block in section.blocks -%}
          {%- if block.settings.title != blank and block.settings.content != blank -%}
            <details {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
              <summary>{{ block.settings.title }}</summary>
              <div class="tbm-acc__body">{{ block.settings.content }}</div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
   </div>
  </div>
</div>

{% schema %}
{
  "name": "TBM · Know more",
  "tag": "section",
  "class": "tbm-pdp-know-more-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Know more" },
    { "type": "richtext", "id": "intro", "label": "Intro text", "info": "Shown under the heading (left column on desktop)." },
    { "type": "range", "id": "pt", "label": "Top padding", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 16 },
    { "type": "range", "id": "pb", "label": "Bottom padding", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 16 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Directions" },
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Dip one teabag in a cup of hot water for 3–5 minutes. Sip and enjoy.</p>", "info": "Connect a product metafield for per-product text." },
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "TBM · Know more",
      "blocks": [
        { "type": "item", "settings": { "title": "Ingredients & Allergies" } },
        { "type": "item", "settings": { "title": "Directions" } }
      ]
    }
  ]
}
{% endschema %}
