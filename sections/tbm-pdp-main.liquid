{%- comment -%}
  tbm-pdp-main — DailyDip product page main section.
  Gallery (left / top) + block-based info column (right / below).
  Each variant renders as a pack card. Optional variant metafields:
    custom.badge     → yellow pill above the card (e.g. BEST SELLER)
    custom.subtitle  → small line under the pack name (e.g. 60 Servings)
    custom.servings  → integer; enables "₹x / serving" on the card
  Works without theme JS — adds to cart via the AJAX API and refreshes
  the theme's offcanvas cart + count badge with section rendering.
{%- endcomment -%}


{%- if section.settings.load_fonts -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">
{%- endif -%}

<style>
  .tbm-pdp {
    --tbm-ink: {{ section.settings.c_ink }};
    --tbm-card: {{ section.settings.c_card }};
    --tbm-green: {{ section.settings.c_green }};
    --tbm-green-h: {{ section.settings.c_green | color_lighten: 6 }};
    --tbm-lime: {{ section.settings.c_lime }};
    --tbm-yellow: {{ section.settings.c_yellow }};
    --tbm-red: {{ section.settings.c_red }};
    --tbm-mute: {{ section.settings.c_mute }};
    --tbm-chip: {{ section.settings.c_chip }};
    --tbm-atc-depth: {{ section.settings.c_atc_depth | default: section.settings.c_ink }};
    --tbm-buy-depth: {{ section.settings.c_buy_depth | default: section.settings.c_ink }};
    {%- unless section.settings.load_fonts %}
    --tbm-font-head: inherit;
    --tbm-font-body: inherit;
    {%- endunless %}
  }
  #shopify-section-{{ section.id }} .tbm-pdp-main {
    background: {{ section.settings.c_bg }};
    padding-top: {{ section.settings.pt }}px;
    padding-bottom: {{ section.settings.pb }}px;
  }
</style>

{%- liquid
  assign current = product.selected_or_first_available_variant
  assign form_id = 'tbm-pdp-form-' | append: section.id
  assign save_tpl = section.settings.save_label | default: 'Save [percent]%'

  case section.settings.img_ratio
    when 'portrait'
      assign gal_ratio = '4 / 5'
    when 'landscape'
      assign gal_ratio = '4 / 3'
    else
      assign gal_ratio = '1'
  endcase
-%}

<tbm-pdp-main
  class="tbm-pdp tbm-pdp-main"
  data-section="{{ section.id }}"
  data-url="{{ product.url }}"
  data-added-label="{{ section.settings.added_label | escape }}"
  data-cart-action="{{ section.settings.after_add }}"
>
  <script type="application/json" data-tbm-variants>
    [
      {%- for v in product.variants -%}
        {%- liquid
          assign v_save = ''
          if v.compare_at_price > v.price
            assign pct = v.compare_at_price | minus: v.price | times: 100.0 | divided_by: v.compare_at_price | round
            assign v_save = save_tpl | replace: '[percent]', pct
          endif
          assign v_inv = 'null'
          if v.inventory_management == 'shopify' and v.inventory_policy == 'deny'
            assign v_inv = v.inventory_quantity
          endif
        -%}
        {
          "id": {{ v.id }},
          "title": {{ v.title | json }},
          "available": {{ v.available | json }},
          "price": {{ v.price | money_without_trailing_zeros | json }},
          "compare": {% if v.compare_at_price > v.price %}{{ v.compare_at_price | money_without_trailing_zeros | json }}{% else %}""{% endif %},
          "save": {{ v_save | json }},
          "inv": {{ v_inv }},
          "media": {% if v.featured_media %}{{ v.featured_media.id }}{% else %}null{% endif %},
          "img": {% if v.featured_image %}{{ v.featured_image | image_url: width: 160 | json }}{% elsif product.featured_image %}{{ product.featured_image | image_url: width: 160 | json }}{% else %}null{% endif %}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>

  <div class="tbm-pdp__wrap">
    <div class="tbm-pdp-main__grid">

      {%- comment -%} ---------- Gallery ---------- {%- endcomment -%}
      <div class="tbm-pdp-main__media">
        <div class="tbm-box tbm-gal" style="--tbm-gal-ratio: {{ gal_ratio }}; --tbm-gal-fit: {{ section.settings.img_fit }};">
          <div class="tbm-gal__stage">
            {%- if section.settings.tag != blank -%}
              <span class="tbm-gal__tag">{{ section.settings.tag }}</span>
            {%- endif -%}
            <div class="tbm-gal__track" data-tbm-track tabindex="0" aria-label="{{ product.title | escape }} images">
              {%- for media in product.media -%}
                {%- liquid
                  assign img = media.preview_image
                  assign img_loading = 'lazy'
                  assign img_priority = 'auto'
                  if forloop.first
                    assign img_loading = 'eager'
                    assign img_priority = 'high'
                  endif
                -%}
                <div class="tbm-gal__slide" data-media-id="{{ media.id }}" id="tbm-slide-{{ section.id }}-{{ forloop.index }}">
                  {{ img | image_url: width: 1200 | image_tag:
                      widths: '400, 600, 800, 1000, 1200',
                      sizes: '(min-width: 990px) 560px, 100vw',
                      loading: img_loading,
                      fetchpriority: img_priority,
                      alt: img.alt | default: product.title
                  }}
                </div>
              {%- else -%}
                <div class="tbm-gal__slide">{{ 'product-1' | placeholder_svg_tag }}</div>
              {%- endfor -%}
            </div>
            {%- if product.media.size > 1 -%}
              <button type="button" class="tbm-gal__arrow tbm-gal__arrow--prev" data-tbm-prev aria-label="Previous image">&#8249;</button>
              <button type="button" class="tbm-gal__arrow tbm-gal__arrow--next" data-tbm-next aria-label="Next image">&#8250;</button>
            {%- endif -%}
          </div>
          {%- if product.media.size > 1 -%}
            <div class="tbm-gal__thumbs">
              {%- for media in product.media -%}
                <button
                  type="button"
                  class="tbm-gal__thumb"
                  data-tbm-thumb="{{ forloop.index0 }}"
                  aria-label="Show image {{ forloop.index }}"
                  {% if forloop.first %}aria-current="true"{% endif %}
                >
                  {{ media.preview_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
                </button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} ---------- Info ---------- {%- endcomment -%}
      <div class="tbm-pdp-main__info">
        {%- for block in section.blocks -%}
          {%- case block.type -%}

            {%- when '@app' -%}
              <div {{ block.shopify_attributes }}>{% render block %}</div>

            {%- when 'title' -%}
              <h1 class="tbm-pdp__title" {{ block.shopify_attributes }}>{{ product.title }}</h1>

            {%- when 'rating' -%}
              {%- if product.metafields.reviews.rating.value != blank -%}
                {%- liquid
                  assign r = product.metafields.reviews.rating.value.rating | times: 1.0
                  assign r_count = product.metafields.reviews.rating_count.value | default: 0
                  assign r_full = r | round
                -%}
                <a class="tbm-rate" href="#tbm-pdp-reviews" {{ block.shopify_attributes }}>
                  <span class="tbm-stars" aria-hidden="true">
                    {%- for i in (1..5) -%}{% if i <= r_full %}★{% else %}☆{% endif %}{%- endfor -%}
                  </span>
                  <span>{{ r | round: 1 }} · {{ r_count }} {{ block.settings.reviews_label }}</span>
                </a>
              {%- elsif request.design_mode -%}
                <p class="tbm-rate" {{ block.shopify_attributes }}>Rating shows once the product has reviews (reviews.rating metafield). Or use the reviews app's star block instead.</p>
              {%- endif -%}

            {%- when 'price' -%}
              <div class="tbm-price" {{ block.shopify_attributes }}>
                <span class="tbm-price__now" data-tbm-price>{{ current.price | money_without_trailing_zeros }}</span>
                <s class="tbm-price__mrp" data-tbm-compare {% unless current.compare_at_price > current.price %}hidden{% endunless %}>
                  {%- if current.compare_at_price > current.price -%}{{ current.compare_at_price | money_without_trailing_zeros }}{%- endif -%}
                </s>
                {%- liquid
                  assign save_now = ''
                  if current.compare_at_price > current.price
                    assign pct = current.compare_at_price | minus: current.price | times: 100.0 | divided_by: current.compare_at_price | round
                    assign save_now = save_tpl | replace: '[percent]', pct
                  endif
                -%}
                <span class="tbm-price__save" data-tbm-save {% if save_now == blank %}hidden{% endif %}>{{ save_now }}</span>
                {%- if block.settings.tax_note != blank -%}
                  <p class="tbm-price__tax">{{ block.settings.tax_note }}</p>
                {%- endif -%}
              </div>

            {%- when 'stock' -%}
              {%- liquid
                assign th = block.settings.threshold
                assign show_stock = false
                if current.inventory_management == 'shopify' and current.inventory_policy == 'deny' and current.inventory_quantity > 0 and current.inventory_quantity <= th
                  assign show_stock = true
                endif
                assign bar_w = current.inventory_quantity | times: 100 | divided_by: th
              -%}
              <div class="tbm-stock" data-tbm-stock data-threshold="{{ th }}" data-template="{{ block.settings.text | escape }}" {% unless show_stock %}hidden{% endunless %} {{ block.shopify_attributes }}>
                <p class="tbm-stock__text" data-tbm-stock-text>
                  {{- block.settings.text | replace: '[count]', current.inventory_quantity -}}
                </p>
                <div class="tbm-stock__bar"><i data-tbm-stock-bar style="width: {{ bar_w | at_most: 100 }}%"></i></div>
              </div>

            {%- when 'chips' -%}
              {%- assign chip_lines = block.settings.items | newline_to_br | split: '<br />' -%}
              <div class="tbm-chips" {{ block.shopify_attributes }}>
                {%- for line in chip_lines -%}
                  {%- assign t = line | strip -%}
                  {%- if t != blank -%}
                    <div class="tbm-chip"><span class="tbm-chip__tick" aria-hidden="true">✓</span>{{ t }}</div>
                  {%- endif -%}
                {%- endfor -%}
              </div>

            {%- when 'description' -%}
              <div class="tbm-desc" {{ block.shopify_attributes }}>
                {%- if block.settings.text != blank -%}
                  {{ block.settings.text }}
                {%- else -%}
                  {{ product.description }}
                {%- endif -%}
              </div>

            {%- when 'packs' -%}
              {%- unless product.has_only_default_variant -%}
                {%- assign icons = block.settings.icons | split: ',' -%}
                <div {{ block.shopify_attributes }}>
                  {%- if block.settings.title != blank -%}
                    <h2 class="tbm-h2" id="tbm-packs-title-{{ section.id }}">{{ block.settings.title }}</h2>
                  {%- endif -%}
                  <fieldset class="tbm-packs" style="--tbm-pack-cols: {{ block.settings.columns }};" aria-labelledby="tbm-packs-title-{{ section.id }}">
                    {%- for v in product.variants -%}
                      <label class="tbm-pack">
                        <input
                          type="radio"
                          name="tbm-pack-{{ section.id }}"
                          value="{{ v.id }}"
                          data-tbm-pack
                          {% if v.id == current.id %}checked{% endif %}
                          {% unless v.available %}disabled{% endunless %}
                        >
                        <span class="tbm-pack__card">
                          {%- if v.metafields.custom.badge != blank -%}
                            <span class="tbm-pack__badge">{{ v.metafields.custom.badge }}</span>
                          {%- endif -%}
                          {%- if block.settings.show_images and v.featured_image -%}
                            <span class="tbm-pack__media">
                              {{ v.featured_image | image_url: width: 300 | image_tag:
                                  class: 'tbm-pack__img',
                                  widths: '150, 220, 300',
                                  sizes: '(min-width: 768px) 140px, 30vw',
                                  loading: 'lazy',
                                  alt: v.featured_image.alt | default: v.title
                              }}
                            </span>
                          {%- else -%}
                            {%- assign icon = icons[forloop.index0] | strip -%}
                            {%- if icon != blank -%}<span class="tbm-pack__icon" aria-hidden="true">{{ icon }}</span>{%- endif -%}
                          {%- endif -%}
                          <span class="tbm-pack__name">{{ v.title }}</span>
                          {%- if v.metafields.custom.subtitle != blank -%}
                            <span class="tbm-pack__sub">{{ v.metafields.custom.subtitle }}</span>
                          {%- endif -%}
                          <span class="tbm-pack__pr">{{ v.price | money_without_trailing_zeros }}</span>
                          <span class="tbm-pack__mrp">
                            {%- if v.compare_at_price > v.price -%}{{ block.settings.mrp_label }} {{ v.compare_at_price | money_without_trailing_zeros }}{%- endif -%}
                          </span>
                          {%- assign servings = v.metafields.custom.servings.value | plus: 0 -%}
                          {%- if block.settings.show_per_serving and servings > 0 -%}
                            <span class="tbm-pack__per">{{ v.price | divided_by: servings | money_without_trailing_zeros }} / {{ block.settings.serving_label }}</span>
                          {%- endif -%}
                          {%- unless v.available -%}<span class="tbm-pack__per">Sold out</span>{%- endunless -%}
                        </span>
                      </label>
                    {%- endfor -%}
                  </fieldset>
                </div>
              {%- endunless -%}

            {%- when 'buy' -%}
              <div {{ block.shopify_attributes }}>
                {%- form 'product', product, id: form_id, novalidate: 'novalidate', data-tbm-form: '' -%}
                  <input type="hidden" name="id" value="{{ current.id }}" data-tbm-id>
                  <div class="tbm-buy">
                    {%- if block.settings.show_qty -%}
                      <div class="tbm-qty">
                        <button type="button" data-tbm-qty="-1" aria-label="Decrease quantity">−</button>
                        <input type="number" name="quantity" value="1" min="1" inputmode="numeric" aria-label="Quantity" data-tbm-qty-input>
                        <button type="button" data-tbm-qty="1" aria-label="Increase quantity">+</button>
                      </div>
                    {%- endif -%}
                    <button
                      type="submit"
                      name="add"
                      class="tbm-btn"
                      data-tbm-atc
                      data-label="{{ block.settings.atc_label | escape }}"
                      data-soldout="{{ block.settings.soldout_label | escape }}"
                      {% unless current.available %}disabled{% endunless %}
                    >
                      {%- if current.available -%}{{ block.settings.atc_label }}{%- else -%}{{ block.settings.soldout_label }}{%- endif -%}
                    </button>
                  </div>
                  {%- if block.settings.show_buy_now -%}
                    <button type="button" class="tbm-btn tbm-btn--alt{% if block.settings.jump_buy_now %} tbm-btn--jump{% endif %}" data-tbm-buynow {% unless current.available %}disabled{% endunless %}>
                      {{ block.settings.buy_now_label }}
                    </button>
                  {%- endif -%}
                  <p class="tbm-buy__error" data-tbm-error role="alert" hidden></p>
                {%- endform -%}
              </div>

            {%- when 'ship' -%}
              {%- if block.settings.text != blank -%}
                <div class="tbm-ship" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
              {%- endif -%}

            {%- when 'trust' -%}
              {%- assign trust_lines = block.settings.items | newline_to_br | split: '<br />' -%}
              {%- liquid
                assign t_style = block.settings.style | default: 'circles'
                assign t_tints = block.settings.tints | default: '#c8f169,#ffd23f,#bfe6ff,#ffc2b8' | remove: ' ' | split: ','
              -%}
              <div class="tbm-trust tbm-trust--{{ t_style }}" data-tbm-trust {{ block.shopify_attributes }}>
                {%- for line in trust_lines -%}
                  {%- assign parts = line | strip | split: '|' -%}
                  {%- if parts.size > 0 -%}
                    {%- assign t_icon = parts[0] | strip -%}
                    {%- assign t_label = parts[1] | strip -%}
                    {%- if parts.size == 1 -%}{%- assign t_label = t_icon -%}{%- assign t_icon = '' -%}{%- endif -%}
                    {%- assign ti = forloop.index0 | modulo: t_tints.size -%}
                    {%- if t_style == 'circles' -%}
                      <div class="tbm-trust__item" style="--tint: {{ t_tints[ti] }}; --i: {{ forloop.index0 }};">
                        <span class="tbm-trust__bubble" aria-hidden="true">
                          <span class="tbm-trust__tea"><svg viewBox="0 0 120 12" preserveAspectRatio="none"><path d="M0 6 Q15 0 30 6 T60 6 T90 6 T120 6 V12 H0Z"/></svg></span>
                          {%- if t_icon != blank -%}<span class="tbm-trust__icon">{{ t_icon }}</span>{%- endif -%}
                        </span>
                        <span class="tbm-trust__label">{{ t_label }}</span>
                      </div>
                    {%- else -%}
                      <div>
                        {%- if t_icon != blank -%}<span class="tbm-trust__icon" aria-hidden="true">{{ t_icon }}</span>{%- endif -%}
                        {{ t_label }}
                      </div>
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
              </div>

            {%- when 'tabs' -%}
              <div class="tbm-tabs" data-tbm-tabs {{ block.shopify_attributes }}>
                <div class="tbm-tabs__list" role="tablist">
                  {%- assign first_tab = true -%}
                  {%- for i in (1..3) -%}
                    {%- assign t_key = 'tab' | append: i | append: '_title' -%}
                    {%- assign c_key = 'tab' | append: i | append: '_content' -%}
                    {%- if block.settings[t_key] != blank and block.settings[c_key] != blank -%}
                      <button
                        type="button"
                        class="tbm-tab"
                        role="tab"
                        id="tbm-tab-{{ block.id }}-{{ i }}"
                        aria-controls="tbm-panel-{{ block.id }}-{{ i }}"
                        aria-selected="{{ first_tab }}"
                        {% unless first_tab %}tabindex="-1"{% endunless %}
                      >{{ block.settings[t_key] }}</button>
                      {%- assign first_tab = false -%}
                    {%- endif -%}
                  {%- endfor -%}
                </div>
                {%- assign first_tab = true -%}
                {%- for i in (1..3) -%}
                  {%- assign t_key = 'tab' | append: i | append: '_title' -%}
                  {%- assign c_key = 'tab' | append: i | append: '_content' -%}
                  {%- if block.settings[t_key] != blank and block.settings[c_key] != blank -%}
                    <div
                      class="tbm-box tbm-tabs__panel"
                      role="tabpanel"
                      id="tbm-panel-{{ block.id }}-{{ i }}"
                      aria-labelledby="tbm-tab-{{ block.id }}-{{ i }}"
                      {% unless first_tab %}hidden{% endunless %}
                    >{{ block.settings[c_key] }}</div>
                    {%- assign first_tab = false -%}
                  {%- endif -%}
                {%- endfor -%}
              </div>

            {%- when 'text' -%}
              <div class="tbm-desc" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- if section.settings.sticky != 'off' -%}
    {%- liquid
      assign sticky_btns = section.settings.sticky_buttons | default: 'both'
    -%}
    <div class="tbm-sticky tbm-sticky--{{ sticky_btns }} {% if section.settings.sticky == 'mobile' %}tbm-sticky--mobile-only{% endif %}" data-tbm-sticky aria-hidden="true">
      <div class="tbm-sticky__inner">
      {%- assign sticky_img = current.featured_image | default: product.featured_image -%}
      {%- if sticky_img -%}
        <span class="tbm-sticky__thumb">
          <img src="{{ sticky_img | image_url: width: 160 }}" alt="" width="56" height="56" loading="lazy" data-tbm-sticky-img>
        </span>
      {%- endif -%}
      <div class="tbm-sticky__info">
        <div class="tbm-sticky__name">{{ product.title }}</div>
        <div class="tbm-sticky__price"><span data-tbm-sticky-variant>{% unless product.has_only_default_variant %}{{ current.title }}{% endunless %}</span><span data-tbm-price>{{ current.price | money_without_trailing_zeros }}</span></div>
      </div>
      <div class="tbm-sticky__btns">
        {%- unless sticky_btns == 'buy' -%}
          <button type="button" class="tbm-btn" data-tbm-sticky-btn tabindex="-1" {% unless current.available %}disabled{% endunless %}>
            {{ section.settings.sticky_label }}
          </button>
        {%- endunless -%}
        {%- unless sticky_btns == 'atc' -%}
          <button
            type="button"
            class="tbm-btn tbm-btn--alt{% if section.settings.sticky_jump %} tbm-btn--jump{% endif %}"
            data-tbm-sticky-buy
            tabindex="-1"
            {% unless current.available %}disabled{% endunless %}
          >
            {{ section.settings.sticky_buy_label }}
          </button>
        {%- endunless -%}
      </div>
      </div>
    </div>
  {%- endif -%}
</tbm-pdp-main>

{% schema %}
{
  "name": "TBM · Product main",
  "tag": "section",
  "class": "tbm-pdp-main-section",
  "settings": [
    {
      "type": "header",
      "content": "Gallery"
    },
    {
      "type": "text",
      "id": "tag",
      "label": "Image tag",
      "default": "NEW",
      "info": "Leave empty to hide."
    },
    {
      "type": "select",
      "id": "img_ratio",
      "label": "Image ratio",
      "default": "square",
      "options": [
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "portrait",
          "label": "Portrait (4:5)"
        },
        {
          "value": "landscape",
          "label": "Landscape (4:3)"
        }
      ]
    },
    {
      "type": "select",
      "id": "img_fit",
      "label": "Image fit",
      "default": "cover",
      "options": [
        {
          "value": "cover",
          "label": "Fill (crop)"
        },
        {
          "value": "contain",
          "label": "Fit (no crop)"
        }
      ]
    },
    {
      "type": "header",
      "content": "Cart"
    },
    {
      "type": "select",
      "id": "after_add",
      "label": "After add to cart",
      "default": "drawer",
      "options": [
        {
          "value": "drawer",
          "label": "Open cart drawer"
        },
        {
          "value": "cart",
          "label": "Go to cart page"
        },
        {
          "value": "none",
          "label": "Stay on page"
        }
      ]
    },
    {
      "type": "text",
      "id": "added_label",
      "label": "Added confirmation text",
      "default": "ADDED ✓"
    },
    {
      "type": "select",
      "id": "sticky",
      "label": "Sticky add to cart bar",
      "default": "all",
      "options": [
        {
          "value": "mobile",
          "label": "Mobile only"
        },
        {
          "value": "all",
          "label": "All devices"
        },
        {
          "value": "off",
          "label": "Off"
        }
      ]
    },
    {
      "type": "select",
      "id": "sticky_buttons",
      "label": "Sticky bar buttons",
      "default": "both",
      "options": [
        {
          "value": "both",
          "label": "Add to cart + Buy it now"
        },
        {
          "value": "buy",
          "label": "Buy it now only"
        },
        {
          "value": "atc",
          "label": "Add to cart only"
        }
      ]
    },
    {
      "type": "text",
      "id": "sticky_label",
      "label": "Sticky add to cart text",
      "default": "Add to cart"
    },
    {
      "type": "text",
