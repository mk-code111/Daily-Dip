<div
  id="trust-icons-{{ section.id }}" 
  class="
    trust-icons 
    {{ section.settings.bg_color }}
    {{ section.settings.text_color }}
    {{ section.settings.border_top_width | prepend: 'border-top-' }}
    {{ section.settings.border_bottom_width | prepend: 'border-bottom-' }}
    {{ section.settings.border_color }} 
    {{ section.settings.pt | prepend: 'pt-' }} 
    {{ section.settings.pb | prepend: 'pb-' }}
  "
  style="
    --bs-bg-opacity: {{ section.settings.bg_opacity | append: '%' }};
    --bs-border-opacity: {{ section.settings.border_opacity | append: '%' }};
    background-image: linear-gradient({{ section.settings.bg_gradient_direction | append: 'deg' }}, rgba(var(--text-color-rgb), {{ section.settings.bg_gradient_opacity | append: '%'}}), rgba(var(--text-color-rgb), 0));
  ">
  <div 
    class="container"
    style="max-width: {{ section.settings.container_max_width }}px;">
    {% render 'section-header' %}
    <div 
      class="
        trust-icons-list row m-n4
        {{ section.settings.breakpoint_mobile | prepend: 'row-cols-' }}
        {{ section.settings.breakpoint_tablet | prepend: 'row-cols-tablet-' }}
        {{ section.settings.breakpoint_desktop | prepend: 'row-cols-desktop-' }}
      "
      role="list"
      aria-label="{{ section.settings.label }}">
      {% for block in section.blocks %}
        <div class="p-4" role="listitem" {{ block.shopify_attributes }}>
          <div 
            class="
              trust-icons-item h-100
              {{ section.settings.item_bg_color }}
              {{ section.settings.item_text_color }}
              {{ section.settings.item_border_width | prepend: 'border-' }}
              {{ section.settings.item_shadow }} 
              {{ section.settings.item_border_color }}
              {{ section.settings.item_text_align }}
              {{ section.settings.item_p | prepend: 'p-' }}
            "
            style="
              --bs-bg-opacity: {{ section.settings.item_bg_opacity | append: '%' }};
              --bs-border-opacity: {{ section.settings.item_border_opacity | append: '%' }};
              background-image: linear-gradient({{ section.settings.item_bg_gradient_direction | append: 'deg' }}, rgba(var(--text-color-rgb), {{ section.settings.item_bg_gradient_opacity | append: '%'}}), rgba(var(--text-color-rgb), 0));
            ">
            <div class="trust-icons-item-inner">
              {% unless block.settings.img == blank %}
                <div class="img-wrapper">
                  {% assign img_height_x2 = section.settings.item_img_height | times: 2 %}
                  <img
                    src="{{ block.settings.img | image_url: height: img_height_x2 }}"
                    class="img-fluid"
                    alt="{{ block.settings.img.alt }}"
                    width="{{ section.settings.item_img_height | times: block.settings.img.aspect_ratio | round }}"
                    height="{{ section.settings.item_img_height }}"
                    loading="lazy"
                    style="height: {{ section.settings.item_img_height }}px;">
                </div>
              {% endunless %}
              <div class="content-wrapper">
                {% unless block.settings.title == blank %}
                  <h3 class="title mb-2 {{ section.settings.item_title_font_size }}">
                    {{ block.settings.title }}
                  </h3>
                {% endunless %}
                {% unless block.settings.description == blank %}
                  <div class="description rte mb-0 lh-sm {{ section.settings.item_description_font_size }}">
                    {{ block.settings.description }}
                  </div>
                {% endunless %}
              </div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

