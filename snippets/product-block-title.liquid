{% liquid 
  assign pt = block.settings.pt | prepend: 'pt-'
  assign pb = block.settings.pb | prepend: 'pb-'
%}

<div class="d-flex justify-content-between align-items-center {{ pt }} {{ pb }}" {{ block.shopify_attributes }}>
  <h1 class="product-title title mb-0 {{ block.settings.title_font_size }}">
    {{ product.title }}
  </h1>
  {% if block.settings.share %}
    <div class="share-btn-wrapper ms-6">
      {% render 'share-button', btn_color: block.settings.share_btn_color %}
    </div>
  {% endif %}
</div>