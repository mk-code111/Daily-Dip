{%- comment -%}
  sf-cart-rewards — reward progress bar for the cart drawer (Theme settings → SF Cart · Rewards).
  Rendered in Liquid, so it is recalculated every time the theme re-renders the drawer
  after a cart change. Gift handling (auto-add / pick popup / removal) is in assets/sf-cart.js.
  Tier source: the DailyDip Rewards app saves the tiers to the shop metafield
  dailydip.rewards (JSON) and keeps the Shopify discounts in sync with them. When that
  metafield exists it is used; otherwise Theme settings → SF Cart · Rewards is used.
{%- endcomment -%}
{%- if settings.sf_rw_enable and cart.item_count > 0 -%}
  {%- liquid
    # ---- tier source: app metafield, else theme settings ------------------
    assign rw_src = shop.metafields.dailydip.rewards.value
    assign use_app = false
    if rw_src and rw_src.tiers
      assign use_app = true
    endif
    if use_app
      assign rw_measure = rw_src.measure | default: 'value'
      assign rw_mode = rw_src.mode | default: 'highest'
      assign rw_done = rw_src.done_text | default: settings.sf_rw_done_text
    else
      assign rw_measure = settings.sf_rw_measure
      assign rw_mode = settings.sf_rw_mode
      assign rw_done = settings.sf_rw_done_text
    endif

    # per-tier values as arrays (index = tier number - 1). Each value gets an 'x'
    # prefix so empty values survive split; read back with remove_first: 'x'.
    assign D = '§§'
    assign a_en = '' 
    assign a_icon = ''
    assign a_type = ''
    assign a_min = ''
    assign a_desc = ''
    assign a_text = ''
    assign a_gmode = ''
    assign a_max = ''
    assign a_gift = ''
    for n in (1..5)
      if use_app
        assign i0 = n | minus: 1
        assign t = rw_src.tiers[i0]
        assign v_en = t.enabled | default: false
        assign v_icon = t.icon
        assign v_type = t.type
        if v_type == 'gift'
          assign v_type = 'product'
        endif
        assign v_min = t.min | default: 0
        assign v_desc = t.desc
        assign v_text = t.text
        assign v_gmode = t.gift_mode | default: 'popup'
        assign v_max = t.max | default: 1
        assign v_gift = t.gift_products | remove: ' '
      else
        assign k = 'sf_rw_t' | append: n | append: '_'
        assign k_en = k | append: 'enable'
        assign k_icon = k | append: 'icon'
        assign k_type = k | append: 'type'
        assign k_min = k | append: 'min'
        assign k_desc = k | append: 'desc'
        assign k_text = k | append: 'text'
        assign k_gmode = k | append: 'gift_mode'
        assign k_max = k | append: 'max'
        assign k_products = k | append: 'products'
        assign v_en = settings[k_en]
        assign v_icon = settings[k_icon]
        assign v_type = settings[k_type]
        assign v_min = settings[k_min] | default: 0
        assign v_desc = settings[k_desc]
        assign v_text = settings[k_text]
        assign v_gmode = settings[k_gmode]
        assign v_max = settings[k_max] | default: 1
        assign v_gift = settings[k_products] | map: 'handle' | join: ','
      endif
      assign a_en = a_en | append: 'x' | append: v_en | append: D
      assign a_icon = a_icon | append: 'x' | append: v_icon | append: D
      assign a_type = a_type | append: 'x' | append: v_type | append: D
      assign a_min = a_min | append: 'x' | append: v_min | append: D
      assign a_desc = a_desc | append: 'x' | append: v_desc | append: D
      assign a_text = a_text | append: 'x' | append: v_text | append: D
      assign a_gmode = a_gmode | append: 'x' | append: v_gmode | append: D
      assign a_max = a_max | append: 'x' | append: v_max | append: D
      assign a_gift = a_gift | append: 'x' | append: v_gift | append: D
    endfor
    assign T_en = a_en | split: D
    assign T_icon = a_icon | split: D
    assign T_type = a_type | split: D
    assign T_min = a_min | split: D
    assign T_desc = a_desc | split: D
    assign T_text = a_text | split: D
    assign T_gmode = a_gmode | split: D
    assign T_max = a_max | split: D
    assign T_gift = a_gift | split: D

    assign by_qty = false
    if rw_measure == 'quantity'
      assign by_qty = true
    endif

    # ---- which lines count -------------------------------------------------
    assign inc_product_ids = settings.sf_rw_products | map: 'id'
    assign inc_collection_ids = settings.sf_rw_collections | map: 'id'
    assign ex_product_ids = settings.sf_rw_ex_products | map: 'id'
    assign ex_collection_ids = settings.sf_rw_ex_collections | map: 'id'

    assign total = 0
    assign gift_lines = ''
    for line in cart.items
      assign gift_prop = line.properties['_sf_gift']
      if gift_prop != blank
        assign gift_lines = gift_lines | append: line.key | append: ':' | append: gift_prop | append: ','
        continue
      endif

      assign counts = true
      if settings.sf_rw_applies == 'products'
        unless inc_product_ids contains line.product_id
          assign counts = false
        endunless
      elsif settings.sf_rw_applies == 'collections'
        assign in_col = false
        for c in line.product.collections
          if inc_collection_ids contains c.id
            assign in_col = true
            break
          endif
        endfor
        unless in_col
          assign counts = false
        endunless
      endif
      if settings.sf_rw_exclude and counts
        if ex_product_ids contains line.product_id
          assign counts = false
        else
          for c in line.product.collections
            if ex_collection_ids contains c.id
              assign counts = false
              break
            endif
          endfor
        endif
      endif

      if counts
        if by_qty
          assign total = total | plus: line.quantity
        elsif settings.sf_rw_calc == 'after'
          assign total = total | plus: line.final_line_price
        else
          assign total = total | plus: line.original_line_price
        endif
      endif
    endfor

    # "after discounts" also takes off order-level discounts when everything counts
    if by_qty == false and settings.sf_rw_calc == 'after' and settings.sf_rw_applies == 'all' and settings.sf_rw_exclude == false
      assign cart_disc = cart.cart_level_discount_applications | map: 'total_allocated_amount' | sum
      assign total = total | minus: cart_disc
      if total < 0
        assign total = 0
      endif
    endif

    # ---- enabled tiers, sorted by threshold --------------------------------
    assign keys = ''
    for n in (1..5)
      assign i0 = n | minus: 1
      assign t_en = T_en[i0] | remove_first: 'x'
      assign t_minv = T_min[i0] | remove_first: 'x' | plus: 0
      if t_en == 'true' and t_minv > 0
        if by_qty
          assign min_units = t_minv | round
        else
          assign min_units = t_minv | times: 100 | round
        endif
        assign padded = '0000000000' | append: min_units | slice: -10, 10
        assign keys = keys | append: padded | append: '|' | append: n | append: ','
      endif
    endfor
    assign tiers = keys | split: ',' | sort
    assign tier_count = tiers.size
  -%}

  {%- if tier_count > 0 -%}
    {%- liquid
      assign achieved = 0
      assign next_n = 0
      assign prev_min = 0
      assign next_min = 0
      for t in tiers
        assign t_min = t | split: '|' | first | plus: 0
        if total >= t_min
          assign achieved = achieved | plus: 1
          assign prev_min = t_min
        elsif next_n == 0
          assign next_n = t | split: '|' | last | plus: 0
          assign next_min = t_min
        endif
      endfor

      if achieved >= tier_count
        assign pct = 100
      else
        assign span = next_min | minus: prev_min
        assign into = total | minus: prev_min
        assign pct = into | times: 1.0 | divided_by: span | plus: achieved | times: 100.0 | divided_by: tier_count
      endif

      if next_n > 0
        assign remaining = next_min | minus: total
        if by_qty
          if remaining == 1
            assign remaining_text = '1 item'
          else
            assign remaining_text = remaining | append: ' items'
          endif
        else
          assign remaining_text = remaining | money_without_trailing_zeros
        endif
        assign i0 = next_n | minus: 1
        assign nt_text = T_text[i0] | remove_first: 'x'
        assign nt_desc = T_desc[i0] | remove_first: 'x'
        # build the min_amount / reward tokens (double braces) without writing them literally here
        assign ob = '{' | append: '{'
        assign cb = '}' | append: '}'
        assign tok_min = ob | append: 'min_amount' | append: cb
        assign tok_min_s = ob | append: ' min_amount ' | append: cb
        assign tok_rw = ob | append: 'reward' | append: cb
        assign tok_rw_s = ob | append: ' reward ' | append: cb
        assign rem_html = '<strong>' | append: remaining_text | append: '</strong>'
        assign msg = nt_text | escape | replace: tok_min, rem_html | replace: tok_min_s, rem_html
        assign msg = msg | replace: tok_rw, nt_desc | replace: tok_rw_s, nt_desc
      else
        assign msg = rw_done | escape
      endif
    -%}
    <sf-cart-rewards
      class="sf-rw{% if achieved >= tier_count %} is-complete{% endif %}"
      data-achieved="{{ achieved }}"
      data-mode="{{ rw_mode }}"
      style="--sf-rw-pct: {{ pct | at_most: 100 | at_least: 0 }}%; --sf-rw-n: {{ tier_count }};"
    >
      <p class="sf-rw__msg" role="status">{{ msg }}</p>

      <div class="sf-rw__track" aria-hidden="true">
        <div class="sf-rw__fill"></div>
      </div>

      <ol class="sf-rw__tiers" role="list">
        {%- for t in tiers -%}
          {%- liquid
            assign n = t | split: '|' | last | plus: 0
            assign t_min = t | split: '|' | first | plus: 0
            assign i0 = n | minus: 1
            assign t_icon = T_icon[i0] | remove_first: 'x'
            assign t_desc = T_desc[i0] | remove_first: 'x'
            assign done = false
            if total >= t_min
              assign done = true
            endif
            assign superseded = false
            if done and rw_mode == 'highest' and forloop.index < achieved
              assign superseded = true
            endif
            if by_qty
              assign label_min = t_min | append: '+ items'
            else
              assign label_min = t_min | money_without_trailing_zeros
            endif
          -%}
          <li
            class="sf-rw__tier{% if done %} is-done{% endif %}{% if superseded %} is-superseded{% endif %}"
            style="--sf-rw-pos: {{ forloop.index | times: 100.0 | divided_by: tier_count }}%;"
            data-tier="{{ n }}"
          >
            <span class="sf-rw__icon">
              {%- render 'sf-rw-icon', name: t_icon -%}
              {%- if done -%}<span class="sf-rw__tick" aria-hidden="true">✓</span>{%- endif -%}
            </span>
            <span class="sf-rw__label">
              <strong>{{ t_desc }}</strong>
              <span>{{ label_min }}</span>
            </span>
            <span class="visually-hidden">{% if done %}Unlocked{% else %}Locked{% endif %}</span>
          </li>
        {%- endfor -%}
      </ol>

      {%- comment -%} Free-gift tiers: picker data for sf-cart.js {%- endcomment -%}
      {%- liquid
        assign gift_tiers = ''
        for t in tiers
          assign n = t | split: '|' | last | plus: 0
          assign t_min = t | split: '|' | first | plus: 0
          assign i0 = n | minus: 1
          assign t_type = T_type[i0] | remove_first: 'x'
          if t_type == 'product'
            assign gift_tiers = gift_tiers | append: n | append: ','
          endif
        endfor
      -%}
      {%- if gift_tiers != blank -%}
        {%- assign gift_tier_list = gift_tiers | split: ',' -%}
        <script type="application/json" data-sf-rw-gifts>
          {
            "giftLines": [
              {%- assign gl = gift_lines | split: ',' -%}
              {%- for g in gl -%}{"key": {{ g | split: ':' | first | json }}, "tier": {{ g | split: ':' | last | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}
            ],
            "tiers": [
              {%- for gt in gift_tier_list -%}
                {%- liquid
                  assign n = gt | plus: 0
                  assign i0 = n | minus: 1
                  assign g_min = T_min[i0] | remove_first: 'x' | plus: 0
                  unless by_qty
                    assign g_min = g_min | times: 100
                  endunless
                  assign g_mode = T_gmode[i0] | remove_first: 'x'
                  assign g_max = T_max[i0] | remove_first: 'x' | plus: 0 | at_least: 1
                  assign g_handles = T_gift[i0] | remove_first: 'x' | split: ','
                -%}
                {
                  "tier": "{{ n }}",
                  "unlocked": {% if total >= g_min %}true{% else %}false{% endif %},
                  "mode": {{ g_mode | json }},
                  "max": {{ g_max }},
                  "variants": [
                    {%- assign first_v = true -%}
                    {%- for h in g_handles -%}
                      {%- assign gp = all_products[h] -%}
                      {%- if gp.id -%}
                        {%- assign gv = gp.selected_or_first_available_variant -%}
                        {%- unless first_v -%},{%- endunless -%}{%- assign first_v = false -%}
                        {"id": {{ gv.id }}, "available": {{ gv.available }}, "title": {{ gp.title | json }}}
                      {%- endif -%}
                    {%- endfor -%}
                  ]
                }{%- unless forloop.last -%},{%- endunless -%}
              {%- endfor -%}
            ]
          }
        </script>
        {%- for gt in gift_tier_list -%}
          {%- liquid
            assign n = gt | plus: 0
            assign i0 = n | minus: 1
            assign g_min = T_min[i0] | remove_first: 'x' | plus: 0
            unless by_qty
              assign g_min = g_min | times: 100
            endunless
            assign g_mode = T_gmode[i0] | remove_first: 'x'
            assign g_desc = T_desc[i0] | remove_first: 'x'
            assign g_handles = T_gift[i0] | remove_first: 'x' | split: ','
          -%}
          {%- if total >= g_min and g_mode == 'popup' and g_handles.size > 0 -%}
            <div class="sf-rw__gift">
              <button type="button" class="sf-rw__gift-btn" data-sf-gift-open="{{ n }}" aria-expanded="false">
                🎁 Choose your {{ g_desc | default: 'free gift' | downcase }}
              </button>
              <div class="sf-rw__gift-list" data-sf-gift-list="{{ n }}" hidden>
                {%- for h in g_handles -%}
                  {%- assign gp = all_products[h] -%}
                  {%- if gp.id -%}
                    {%- assign gv = gp.selected_or_first_available_variant -%}
                    <div class="sf-rw__gift-item">
                      {%- if gp.featured_image -%}
                        {{ gp.featured_image | image_url: width: 120 | image_tag: width: 52, height: 52, loading: 'lazy', alt: gp.title }}
                      {%- endif -%}
                      <span class="sf-rw__gift-name">{{ gp.title }}</span>
                      <button type="button" class="sf-rw__gift-add" data-sf-gift-add="{{ gv.id }}" data-tier="{{ n }}"{% unless gv.available %} disabled{% endunless %}>
                        {%- if gv.available -%}Add{%- else -%}Sold out{%- endif -%}
                      </button>
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </sf-cart-rewards>
  {%- endif -%}
{%- endif -%}
