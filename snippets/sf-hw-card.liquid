{%- comment -%}
  One photo/video card for sf-hero-wheel.
  Params: b (block or nil), i (index for starter images), editable (bool: add editor attributes)
{%- endcomment -%}
{%- liquid
  assign sn = i | modulo: 8
  case sn
    when 0
      assign starter = 'sf-about-hero-1.jpg'
    when 1
      assign starter = 'sf-about-step-1.jpg'
    when 2
      assign starter = 'sf-about-hero-2.jpg'
    when 3
      assign starter = 'sf-about-step-2.jpg'
    when 4
      assign starter = 'sf-about-hero-3.jpg'
    when 5
      assign starter = 'sf-about-step-3.jpg'
    when 6
      assign starter = 'sf-about-hero-4.jpg'
    else
      assign starter = 'sf-about-step-4.jpg'
  endcase
  assign focal = 'center'
  if b.settings.image.presentation.focal_point != blank
    assign focal = b.settings.image.presentation.focal_point
  endif
  assign img_style = 'object-position: ' | append: focal
  assign alt = b.settings.image.alt | default: shop.name | escape
-%}
<div class="sf-hw__card"{% if editable and b %} {{ b.shopify_attributes }}{% endif %}>
  <div class="sf-hw__media">
    {%- if b.settings.video != blank -%}
      {{ b.settings.video | video_tag: autoplay: false, loop: true, muted: true, controls: false, playsinline: true, preload: 'none', image_size: '600x', class: 'sf-hw__vid' }}
    {%- elsif b.settings.image != blank -%}
      {{ b.settings.image | image_url: width: 640 | image_tag: loading: 'lazy', widths: '320, 480, 640', sizes: '(min-width: 750px) 200px, 46vw', alt: alt, class: 'sf-hw__img', style: img_style }}
    {%- else -%}
      <img class="sf-hw__img" src="{{ starter | asset_url }}" alt="{{ alt }}" loading="lazy" width="600" height="600">
    {%- endif -%}
  </div>
</div>
