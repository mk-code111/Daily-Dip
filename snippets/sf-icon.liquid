{%- comment -%}
  sf-icon — small outline icons for SF sections. Usage: {% render 'sf-icon', name: 'leaf' %}
  Names: leaf, drop, cup, cup-steam, heart, shield, star, check, sparkle, gut, sun, sunrise, moon, moon-star, globe,
         search, user, bag, cart, menu, close, chevron-down,
         truck, gift, percent, clock, tag, return, lock, award, hand-leaf, flask, chat
{%- endcomment -%}
<svg class="sf-icon sf-icon--{{ name | default: 'leaf' }}" viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {%- case name -%}
    {%- when 'drop' -%}
      <path d="M12 3s6 6.6 6 11a6 6 0 0 1-12 0c0-4.4 6-11 6-11z"/>
    {%- when 'cup' -%}
      <path d="M4 8h12v5a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5V8z"/><path d="M16 9h1.5a2.5 2.5 0 0 1 0 5H16"/>
    {%- when 'heart' -%}
      <path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/>
    {%- when 'shield' -%}
      <path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6l7-3z"/><path d="M9 12l2 2 4-4"/>
    {%- when 'star' -%}
      <path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z"/>
    {%- when 'check' -%}
      <circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.7 2.7L16 10"/>
    {%- when 'sparkle' -%}
      <path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5L18 18M18 6l-2.5 2.5M8.5 15.5L6 18"/>
    {%- when 'gut' -%}
      <path d="M8 4v3c0 1.7 1.3 3 3 3h2a3 3 0 0 1 0 6h-3a2 2 0 0 0 0 4h6"/><path d="M16 4v3"/>
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="6.5"/><path d="M16 16l4.5 4.5"/>
    {%- when 'user' -%}
      <circle cx="12" cy="8.5" r="4"/><path d="M4.5 20.5c1.2-3.8 4-5.5 7.5-5.5s6.3 1.7 7.5 5.5"/>
    {%- when 'bag' -%}
      <path d="M5 8h14l-1.2 11.2a2 2 0 0 1-2 1.8H8.2a2 2 0 0 1-2-1.8L5 8z"/><path d="M9 10V7a3 3 0 0 1 6 0v3"/>
    {%- when 'cart' -%}
      <path d="M3 4h2.2l2.2 10.6a1.8 1.8 0 0 0 1.8 1.4h8.2a1.8 1.8 0 0 0 1.7-1.3L21 8H6.3"/><circle cx="9.5" cy="20" r="1.4"/><circle cx="17" cy="20" r="1.4"/>
    {%- when 'menu' -%}
      <path d="M4 7h16M4 12h16M4 17h10"/>
    {%- when 'close' -%}
      <path d="M6 6l12 12M18 6L6 18"/>
    {%- when 'chevron-down' -%}
      <path d="M6 9.5l6 6 6-6"/>
    {%- when 'cup-steam' -%}
      <path d="M4 11h12v3.5a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5V11z"/><path d="M16 12h1.5a2.5 2.5 0 0 1 0 5H16"/><path d="M8 4c-.8 1 .8 2 0 3M11 3.5c-.8 1 .8 2 0 3M14 4c-.8 1 .8 2 0 3"/>
    {%- when 'sunrise' -%}
      <path d="M4 18h16M7 18a5 5 0 0 1 10 0"/><path d="M12 6v3M5.6 10.6l1.6 1.6M18.4 10.6l-1.6 1.6M2.5 15H4M20 15h1.5"/>
    {%- when 'moon' -%}
      <path d="M19.5 14.5A8 8 0 1 1 9.5 4.5a6.5 6.5 0 0 0 10 10z"/>
    {%- when 'moon-star' -%}
      <path d="M18.5 15.5A7.5 7.5 0 1 1 8.5 5.5a6 6 0 0 0 10 10z"/><path d="M17 3.5l.7 1.6 1.6.7-1.6.7-.7 1.6-.7-1.6-1.6-.7 1.6-.7z"/>
    {%- when 'globe' -%}
      <circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.6 2.7 2.6 15.3 0 18M12 3c-2.6 2.7-2.6 15.3 0 18M4.5 7.5h15M4.5 16.5h15"/>
    {%- when 'sun' -%}
      <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
    {%- when 'truck' -%}
      <path d="M3 6h11v10H3z"/><path d="M14 9h4l3 3.5V16h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/>
    {%- when 'gift' -%}
      <path d="M4 10h16v10H4z"/><path d="M3 7h18v3H3zM12 7v13"/><path d="M12 7c-1.5-3-5-3.5-5-1.2C7 7 9.5 7 12 7zM12 7c1.5-3 5-3.5 5-1.2C17 7 14.5 7 12 7z"/>
    {%- when 'percent' -%}
      <path d="M18 6L6 18"/><circle cx="7.5" cy="7.5" r="2.2"/><circle cx="16.5" cy="16.5" r="2.2"/>
    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>
    {%- when 'tag' -%}
      <path d="M3.5 12.5V4h8.5l8.5 8.5-8 8z"/><circle cx="8" cy="8.5" r="1.3"/>
    {%- when 'return' -%}
      <path d="M4 12a8 8 0 0 1 13.7-5.6L20 8.5"/><path d="M20 4v4.5h-4.5"/><path d="M20 12a8 8 0 0 1-13.7 5.6L4 15.5"/><path d="M4 20v-4.5h4.5"/>
    {%- when 'lock' -%}
      <rect x="5" y="10.5" width="14" height="10" rx="2.5"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"/><path d="M12 14.5v2.5"/>
    {%- when 'award' -%}
      <circle cx="12" cy="9.5" r="5.5"/><path d="M9 14.2L7.5 21l4.5-2.5 4.5 2.5-1.5-6.8"/><path d="M10 9.5l1.5 1.5 2.7-2.8"/>
    {%- when 'hand-leaf' -%}
      <path d="M3 15h3l4 3h6.5a1.5 1.5 0 0 0 0-3H12"/><path d="M6 15l3.5-2.5H13a1.5 1.5 0 0 1 0 3"/><path d="M14 9c0-3.5 2.5-6 6-6 0 3.5-2.5 6-6 6zM14 9l3-3"/>
    {%- when 'flask' -%}
      <path d="M9.5 3h5M10.5 3v6L5 18.5A1.7 1.7 0 0 0 6.5 21h11a1.7 1.7 0 0 0 1.5-2.5L13.5 9V3"/><path d="M7.5 15h9"/>
    {%- when 'chat' -%}
      <path d="M4 5h16v11H9l-5 4z"/><path d="M8.5 10.5h.01M12 10.5h.01M15.5 10.5h.01"/>
    {%- when 'phone' -%}
      <path d="M6.5 3.5h3l1.5 4-2 1.3a10 10 0 0 0 6.2 6.2l1.3-2 4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.5 5.7a2 2 0 0 1 2-2.2z"/>
    {%- when 'mail' -%}
      <rect x="3.5" y="5.5" width="17" height="13" rx="2.5"/><path d="M4.5 7l7.5 6 7.5-6"/>
    {%- when 'pin' -%}
      <path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z"/><circle cx="12" cy="10" r="2.4"/>
    {%- when 'arrow-up' -%}
      <path d="M12 19V5M6 11l6-6 6 6"/>
    {%- else -%}
      <path d="M5 19c0-8 5-13 14-14-1 9-6 14-14 14z"/><path d="M5 19l7-7"/>
{%- endcase -%}
</svg>
