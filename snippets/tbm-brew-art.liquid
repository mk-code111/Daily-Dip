{%- comment -%}
  Ink-line illustrations for TBM product-page sections.
  Brew steps: kettle, bag, timer, cup, honey, repeat, ice
  Botanicals: flower, ginger, cinnamon, fennel, root, leaf, citrus, berry, seed, mint, chamomile
  Usage: {% render 'tbm-brew-art', name: 'kettle' %}
{%- endcomment -%}
<svg class="tbm-art tbm-art--{{ name }}" viewBox="0 0 64 64" fill="none" stroke="#1c1c1c" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'kettle' -%}
      <path d="M16 28h30v16a10 10 0 0 1-10 10H26a10 10 0 0 1-10-10z" fill="#fff"/><path d="M46 32l8-6v4"/><path d="M22 28c0-8 4-12 9-12s9 4 9 12"/><path d="M31 16v-3"/><path d="M12 54h40"/><path class="tbm-art__steam" d="M52 18c-3-3 3-5 0-9"/>
    {%- when 'bag' -%}
      <path d="M22 26l10-8 10 8v20a4 4 0 0 1-4 4H26a4 4 0 0 1-4-4z" fill="#fff"/><path d="M27 36h10M27 42h10"/><path d="M32 18c0-6 6-8 10-6 4 2 4 8 0 10"/><rect x="40" y="20" width="12" height="10" rx="2" fill="#ffd23f"/><path class="tbm-art__drip" d="M32 54v4"/>
    {%- when 'timer' -%}
      <circle cx="32" cy="36" r="17" fill="#fff"/><path d="M32 36V26"/><path class="tbm-art__hand" d="M32 36l7 5"/><path d="M27 13h10M32 13v6"/><path d="M47 21l3-3"/>
