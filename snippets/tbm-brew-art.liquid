      <circle cx="32" cy="30" r="6" fill="#ffd23f"/><path d="M32 18v6M32 36v6M20 30h6M38 30h6M24 22l4 4M40 22l-4 4M24 38l4-4M40 38l-4-4"/><path d="M32 42v14"/>
