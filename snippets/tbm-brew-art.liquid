    {%- when 'honey' -%}
      <path d="M18 24h20v26a4 4 0 0 1-4 4H22a4 4 0 0 1-4-4z" fill="#fff"/><path d="M16 24h24M22 18h12v6H22z"/><path d="M22 36h12"/><circle cx="48" cy="40" r="9" fill="#ffd23f"/><path d="M48 31v18M39 40h18"/>
    {%- when 'repeat' -%}
      <rect x="12" y="16" width="40" height="36" rx="5" fill="#fff"/><path d="M12 26h40M22 12v8M42 12v8"/><path d="M24 40l5 5 11-11"/>
