    {%- when 'seed' -%}
      <ellipse cx="24" cy="34" rx="6" ry="10" transform="rotate(-25 24 34)" fill="#fff"/><ellipse cx="40" cy="34" rx="6" ry="10" transform="rotate(25 40 34)" fill="#fff"/><path d="M24 26v16M40 26v16"/>
    {%- when 'mint' -%}
      <path d="M32 56V20"/><path d="M32 30c-10 0-16-6-16-14 10 0 16 6 16 14zM32 40c10 0 16-6 16-14-10 0-16 6-16 14z" fill="#fff"/><path d="M22 20l10 10M42 30l-10 10"/>
